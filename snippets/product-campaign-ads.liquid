{%- if has_campaign -%}
<div class="pdp-campaign" aria-label="{{ sec_title | escape }}">
  <div class="pdp-campaign__intro">
    <p class="pdp-campaign__eyebrow">{{ sec_eyebrow }}</p>
    <h3 class="pdp-campaign__title">{{ sec_title }}</h3>
    <div class="pdp-campaign__pills">
      <span>✓ {{ p1 }}</span>
      <span>✓ {{ p2 }}</span>
      <span>✓ {{ p3 }}</span>
      <span>✓ {{ p4 }}</span>
    </div>
  </div>

  <figure class="pdp-campaign__hero">
    <div class="pdp-campaign__hero-media">
      <img src="{{ hero_img }}" width="1536" height="1024" loading="lazy" decoding="async" style="object-position: {{ hero_pos }};" alt="{{ hero_title | escape }}">
      <span class="pdp-campaign__tag">{{ hero_tag }}</span>
    </div>
    <figcaption class="pdp-campaign__caption pdp-campaign__caption--hero">
      <h4>{{ hero_title }}</h4>
      <p>{{ hero_copy }}</p>
    </figcaption>
  </figure>

  <div class="pdp-campaign__grid">
    <figure class="pdp-campaign__card">
      <div class="pdp-campaign__card-media">
        <img src="{{ c1_img }}" width="1024" height="1280" loading="lazy" decoding="async" style="object-position: {{ c1_pos }};" alt="{{ c1_title | escape }}">
        <span class="pdp-campaign__tag">{{ c1_tag }}</span>
      </div>
      <figcaption class="pdp-campaign__caption">
        <h4>{{ c1_title }}</h4>
        <p>{{ c1_copy }}</p>
      </figcaption>
    </figure>

    <figure class="pdp-campaign__card">
      <div class="pdp-campaign__card-media">
        <img src="{{ c2_img }}" width="1024" height="1280" loading="lazy" decoding="async" style="object-position: {{ c2_pos }};" alt="{{ c2_title | escape }}">
        <span class="pdp-campaign__tag">{{ c2_tag }}</span>
      </div>
      <figcaption class="pdp-campaign__caption">
        <h4>{{ c2_title }}</h4>
        <p>{{ c2_copy }}</p>
      </figcaption>
    </figure>
  </div>
</div>
{%- endif -%}
