<aside class="account-sidebar">
  <div class="account-sidebar__identity">
    <p class="eyebrow">Account</p>
    <h2>Welcome, {{ customer.first_name | default: 'friend' }}</h2>
    <p>{{ customer.email }}</p>
    <a class="button button--dark button--full" href="{{ routes.account_logout_url }}">Sign out</a>
  </div>
  <nav class="account-sidebar__nav" aria-label="Account navigation">
    <a href="{{ routes.account_url }}"{% if request.page_type == 'customers/account' %} aria-current="page"{% endif %}>Overview</a>
    <a href="{{ routes.account_url }}#AccountOrders"{% if request.page_type == 'customers/order' %} aria-current="page"{% endif %}>Orders</a>
    <a href="{{ routes.account_url }}#AccountProfile">Profile</a>
    <a href="{{ routes.account_addresses_url }}"{% if request.page_type == 'customers/addresses' %} aria-current="page"{% endif %}>Addresses</a>
  </nav>
</aside>
