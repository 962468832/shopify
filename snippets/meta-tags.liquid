{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign search_target = request.origin | append: routes.search_url | append: '?q=' | append: '{' | append: 'search_term_string' | append: '}'
  assign structured_product_variant = product.selected_or_first_available_variant
  assign structured_product_url = request.origin | append: product.url
  assign structured_product_availability = 'https://schema.org/InStock'
  unless structured_product_variant.available
    assign structured_product_availability = 'https://schema.org/OutOfStock'
  endunless
  assign structured_article_url = request.origin | append: article.url
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if page_image %}
<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
<meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
{%- endif %}
{%- if request.page_type == 'product' %}
<meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
<meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if request.page_type == 'product' %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | strip_newlines | json }},
    "url": {{ structured_product_url | json }},
    "brand": {"@type": "Brand", "name": {{ product.vendor | default: shop.name | json }}},
    "image": [{% for image in product.images %}{{ image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
    "offers": {
      "@type": "Offer",
      "url": {{ structured_product_url | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ structured_product_variant.price | divided_by: 100.0 | json }},
      "availability": {{ structured_product_availability | json }}
    }
  }
</script>
{%- elsif request.page_type == 'article' %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "description": {{ article.excerpt_or_content | strip_html | strip_newlines | truncate: 300 | json }},
    "url": {{ structured_article_url | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "author": {"@type": "Person", "name": {{ article.author | json }}}{% if article.image %},
    "image": [{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}]{% endif %}
  }
</script>
{%- elsif request.page_type == 'index' %}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: routes.root_url | json }},
    "logo": {{ 'new-black-logo.png' | asset_url | prepend: 'https:' | json }}
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: routes.root_url | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {{ search_target | json }},
      "query-input": "required name=search_term_string"
    }
  }
</script>
{%- endif %}
