<div id="fit-size-guide" class="size-guide" aria-hidden="true">
  <div class="size-guide__backdrop" data-size-guide-close></div>
  <section class="size-guide__panel" role="dialog" aria-modal="true" aria-labelledby="SizeGuideTitle" tabindex="-1">
    <header class="size-guide__head">
      <h2 id="SizeGuideTitle">
        <svg viewBox="0 0 24 24" width="25" height="25" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14.5 4.5 5 5L8 21H3v-5Z"></path><path d="m13 6 5 5"></path><path d="m11 8 2 2"></path><path d="m8 11 2 2"></path><path d="m5 14 2 2"></path></svg>
        {{ 'products.product.size_guide' | t }}
      </h2>
      <button class="icon-button" type="button" data-size-guide-close aria-label="Close size guide">&times;</button>
    </header>
    <div class="size-guide__tabs" role="tablist" aria-label="Size guide sections">
      <button id="SizeChartTab" type="button" role="tab" aria-selected="true" aria-controls="SizeChartPanel" data-size-guide-tab="chart">{{ 'size.size_chart' | t }}</button>
      <button id="FitGuideTab" type="button" role="tab" aria-selected="false" aria-controls="FitGuidePanel" tabindex="-1" data-size-guide-tab="fit">{{ 'size.fit_guide' | t }}</button>
      <button id="FitHelpTab" type="button" role="tab" aria-selected="false" aria-controls="FitHelpPanel" tabindex="-1" data-size-guide-tab="help">{{ 'size.problem_help' | t }}</button>
    </div>
    <div class="size-guide__body">
      <section id="SizeChartPanel" role="tabpanel" aria-labelledby="SizeChartTab" data-size-guide-panel="chart">
        <div class="size-guide__chart-head">
          <h3>{{ 'size.underwear_chart' | t }}</h3>
          <div class="size-guide__units" role="group" aria-label="Measurement unit">
            <button type="button" data-size-guide-unit="in" aria-pressed="true">{{ 'size.inches' | t }}</button>
            <button type="button" data-size-guide-unit="cm" aria-pressed="false">{{ 'size.centimeters' | t }}</button>
          </div>
        </div>
        <div class="size-guide__table-scroll">
          <table class="size-guide__table">
            <thead><tr><th scope="col">{{ 'size.size' | t }}</th><th scope="col">{{ 'size.waist' | t }} <span data-size-guide-unit-label>(in)</span></th><th scope="col">{{ 'size.hip' | t }} <span data-size-guide-unit-label>(in)</span></th><th scope="col">{{ 'size.us_size' | t }}</th></tr></thead>
            <tbody>
              <tr><th scope="row">S</th><td><span data-size-in="24 - 26" data-size-cm="61 - 66">24 - 26</span></td><td><span data-size-in="35 - 36" data-size-cm="89 - 91">35 - 36</span></td><td>0-2</td></tr>
              <tr><th scope="row">M</th><td><span data-size-in="26 - 28" data-size-cm="66 - 71">26 - 28</span></td><td><span data-size-in="37 - 38" data-size-cm="94 - 97">37 - 38</span></td><td>4-6</td></tr>
              <tr><th scope="row">L</th><td><span data-size-in="29 - 31" data-size-cm="74 - 79">29 - 31</span></td><td><span data-size-in="39 - 40" data-size-cm="99 - 102">39 - 40</span></td><td>8-10</td></tr>
              <tr><th scope="row">XL</th><td><span data-size-in="32 - 34" data-size-cm="81 - 86">32 - 34</span></td><td><span data-size-in="41 - 43" data-size-cm="104 - 109">41 - 43</span></td><td>12-14</td></tr>
              <tr><th scope="row">2XL</th><td><span data-size-in="35 - 37" data-size-cm="89 - 94">35 - 37</span></td><td><span data-size-in="44 - 47" data-size-cm="112 - 119">44 - 47</span></td><td>16</td></tr>
              <tr><th scope="row">3XL</th><td><span data-size-in="38 - 42" data-size-cm="97 - 107">38 - 42</span></td><td><span data-size-in="48 - 51" data-size-cm="122 - 130">48 - 51</span></td><td>18-20</td></tr>
              <tr><th scope="row">4XL</th><td><span data-size-in="43 - 45" data-size-cm="109 - 114">43 - 45</span></td><td><span data-size-in="52 - 54" data-size-cm="132 - 137">52 - 54</span></td><td>22-24</td></tr>
              <tr><th scope="row">5XL</th><td><span data-size-in="46 - 48" data-size-cm="117 - 122">46 - 48</span></td><td><span data-size-in="55 - 57" data-size-cm="140 - 145">55 - 57</span></td><td>24-26</td></tr>
            </tbody>
          </table>
        </div>
        <section class="size-guide__how-to" aria-labelledby="SizeGuideMeasureTitle">
          <h3 id="SizeGuideMeasureTitle">{{ 'size.how_to_measure' | t }}</h3>
          <p><strong>{{ 'size.waist' | t }}</strong> - {{ 'size.measure_waist_text' | t }}</p>
          <p><strong>{{ 'size.hip' | t }}</strong> - {{ 'size.measure_hip_text' | t }}</p>
          <img src="{{ 'size-guide-measurement.jpg' | asset_url }}" width="500" height="509" alt="Waist and hip measurement guide: measure the natural waistline and the fullest part of the hips" loading="lazy">
        </section>
        <p class="size-guide__note">{{ 'size.table_note' | t }}</p>
      </section>
      <section id="FitGuidePanel" role="tabpanel" aria-labelledby="FitGuideTab" data-size-guide-panel="fit" hidden>
        <div class="size-guide__finder-head">
          <h3>{{ 'size.find_your_size' | t }}</h3>
          <div class="size-guide__units" role="group" aria-label="Fit guide measurement unit">
            <button type="button" data-size-guide-fit-unit="in" aria-pressed="true">In</button>
            <button type="button" data-size-guide-fit-unit="cm" aria-pressed="false">cm</button>
          </div>
        </div>
        <p class="size-guide__finder-intro">{{ 'size.enter_hip_desc' | t }}</p>
        <label class="size-guide__measurement-label" for="SizeGuideHip">{{ 'size.hip' | t }} <span data-size-guide-fit-unit-label>(in)</span></label>
        <input class="size-guide__measurement-input" id="SizeGuideHip" type="number" inputmode="decimal" min="1" step="0.1" placeholder="e.g. 38" data-size-guide-measurement>
        <fieldset class="size-guide__preferences">
          <legend>{{ 'size.fit_preference' | t }}</legend>
          <div>
            <label><input type="radio" name="size-guide-fit" value="-1" data-size-guide-preference><span>{{ 'size.smoothing' | t }}<small>{{ 'size.smoothing_desc' | t }}</small></span></label>
            <label><input type="radio" name="size-guide-fit" value="0" data-size-guide-preference checked><span>{{ 'size.true_fit' | t }}<small>{{ 'size.true_fit_desc' | t }}</small></span></label>
            <label><input type="radio" name="size-guide-fit" value="1" data-size-guide-preference><span>{{ 'size.relaxed' | t }}<small>{{ 'size.relaxed_desc' | t }}</small></span></label>
          </div>
        </fieldset>
        <div class="size-guide__suggestion" data-size-guide-result>
          <p>{{ 'size.suggested_size' | t }}</p>
          <strong data-size-guide-suggestion>—</strong>
          <p class="size-guide__suggestion-status" data-size-guide-suggestion-status aria-live="polite">{{ 'size.enter_hip' | t }}</p>
          <button class="button button--dark button--full" type="button" data-size-guide-apply disabled>{{ 'size.apply_suggestion' | t }}</button>
        </div>
        <details class="size-guide__measurement-help"><summary>{{ 'size.how_hip' | t }}</summary><p>{{ 'size.how_hip_desc' | t }}</p><img class="size-guide__measurement-image" src="{{ 'size-guide-measurement.jpg' | asset_url }}" width="500" height="509" alt="Illustration showing where to measure the waist and hips" loading="lazy"></details>
        <h3 class="size-guide__subheading">{{ 'size.between_sizes' | t }}</h3>
        <ul class="size-guide__between"><li>{{ 'size.between_smaller' | t }}</li><li>{{ 'size.between_larger' | t }}</li></ul>
      </section>
      <section id="FitHelpPanel" role="tabpanel" aria-labelledby="FitHelpTab" data-size-guide-panel="help" hidden>
        <h3>{{ 'size.solve_by_fit' | t }}</h3>
        <div class="size-guide__help-list">
          <details open><summary>{{ 'size.rolling_waistband' | t }}</summary><p>{{ 'size.rolling_desc' | t }}</p></details>
          <details><summary>{{ 'size.riding_up' | t }}</summary><p>{{ 'size.riding_desc' | t }}</p></details>
          <details><summary>{{ 'size.waistband_digging' | t }}</summary><p>{{ 'size.digging_desc' | t }}</p></details>
          <details><summary>{{ 'size.visible_lines' | t }}</summary><p>{{ 'size.lines_desc' | t }}</p></details>
        </div>
        <p class="size-guide__note">{{ 'size.between_desc' | t }}</p>
      </section>
    </div>
  </section>
</div>
