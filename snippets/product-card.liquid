{%- assign is_pack5 = false -%}
{%- if card_mode == 'pack5' -%}{%- assign is_pack5 = true -%}{%- endif -%}
{%- assign pack_opt_index = -1 -%}
{%- assign color_opt_index = -1 -%}
{%- for opt in product.options_with_values -%}
  {%- assign opt_down = opt.name | downcase -%}
  {%- if opt_down contains 'package' or opt_down contains 'pack' -%}
    {%- assign pack_opt_index = forloop.index0 -%}
  {%- elsif opt_down contains 'color' or opt_down contains 'colour' -%}
    {%- assign color_opt_index = forloop.index0 -%}
  {%- endif -%}
{%- endfor -%}

{%- assign card_variant = blank -%}
{%- assign second_pack_img = blank -%}
{%- if is_pack5 and pack_opt_index >= 0 -%}
  {%- for v in product.variants -%}
    {%- assign v_pack = v.options[pack_opt_index] | downcase -%}
    {%- if v.available and v_pack contains '5' -%}
      {%- if card_variant == blank -%}
        {%- assign card_variant = v -%}
      {%- elsif second_pack_img == blank and v.featured_image != blank and v.featured_image.id != card_variant.featured_image.id -%}
        {%- assign second_pack_img = v.featured_image -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if is_pack5 and card_variant == blank -%}
  {%- comment -%} Skip rendering a 5-Pack card if product has no 5-Pack variant {%- endcomment -%}
{%- else -%}
  {%- if is_pack5 == false -%}
    {%- assign card_variant = product.selected_or_first_available_variant | default: product.variants.first -%}
    {%- if pack_opt_index >= 0 -%}
      {%- for v in product.variants -%}
        {%- assign v_pack = v.options[pack_opt_index] | downcase -%}
        {%- if v.available and v_pack contains 'single' -%}
          {%- assign card_variant = v -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endif -%}

  {%- assign model_card_img = product.metafields.custom.model_card_image.value -%}
  {%- if is_pack5 -%}
    {%- assign card_primary = card_variant.featured_image | default: product.featured_image -%}
    {%- assign card_secondary = second_pack_img | default: model_card_img | default: product.featured_image -%}
    {%- assign card_url = card_variant.url | default: product.url -%}
    {%- assign card_title = product.title | append: ' (5-Pack)' -%}
  {%- else -%}
    {%- assign card_primary = model_card_img | default: product.featured_image -%}
    {%- if model_card_img != blank -%}
      {%- assign card_secondary = product.featured_image -%}
    {%- else -%}
      {%- assign card_secondary = product.images[1] -%}
    {%- endif -%}
    {%- assign card_url = product.url -%}
    {%- assign card_title = product.title -%}
  {%- endif -%}

  {%- assign card_price = card_variant.price | default: product.price -%}
  {%- assign card_compare_at_price = card_variant.compare_at_price | default: 0 -%}
  {%- assign rating_value = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: product.metafields.reviews.rating -%}
  {%- assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count -%}
  {%- if rating_value == blank -%}
    {%- assign judgeme = product.metafields.judgeme.review_widget_data.value -%}
    {%- if judgeme.number_of_reviews > 0 -%}
      {%- assign rating_value = judgeme.average_rating -%}
      {%- assign rating_count = judgeme.number_of_reviews -%}
    {%- endif -%}
  {%- endif -%}
  {%- assign discount_percent = 0 -%}
  {%- if card_compare_at_price > card_price -%}{%- assign discount_percent = card_compare_at_price | minus: card_price | times: 100.0 | divided_by: card_compare_at_price | round -%}{%- endif -%}
  {%- assign card_vendor = product.vendor | strip -%}
  {%- if card_vendor contains 'http' or card_vendor contains 'www.' or card_vendor == '我的商店' -%}{%- assign card_vendor = shop.name -%}{%- endif -%}
  {%- assign best_seller = false -%}
  {%- for card_tag in product.tags -%}{%- assign card_tag_down = card_tag | downcase -%}{%- if card_tag_down contains 'best seller' or card_tag_down contains 'best-seller' or card_tag_down == 'bestseller' -%}{%- assign best_seller = true -%}{%- endif -%}{%- endfor -%}
  {%- assign card_fabric = '' -%}
  {%- if product.tags contains 'seamless' -%}{%- assign card_fabric = 'Seamless Ice-Silk' -%}
  {%- elsif product.tags contains 'cotton-gusset' -%}{%- assign card_fabric = '5A Cotton Gusset' -%}
  {%- elsif product.tags contains 'breathable' -%}{%- assign card_fabric = 'Breathable' -%}
  {%- elsif product.tags contains 'wireless' -%}{%- assign card_fabric = 'Wire-free' -%}{%- endif -%}

<article class="product-card{% if card_secondary != blank %} product-card--has-secondary{% endif %}{% if is_pack5 %} product-card--pack{% endif %}">
  <div class="product-card__media">
    {% if is_pack5 %}
      <span class="badge badge--sale">5-PACK{% if discount_percent > 0 %} · -{{ discount_percent }}%{% endif %}</span>
    {% elsif best_seller %}
      <span class="badge badge--best">{{ 'products.card.best_seller' | t }}</span>
    {% elsif discount_percent > 0 %}
      <span class="badge badge--sale">-{{ discount_percent }}%</span>
    {% endif %}
    <a href="{{ card_url }}">
      {% if card_primary != blank %}
        <img class="product-card__image product-card__image--primary" src="{{ card_primary | image_url: width: 800 }}" width="800" height="1067" alt="{{ card_title | escape }}" loading="lazy">
        {% if card_secondary != blank %}<img class="product-card__image product-card__image--secondary" src="{{ card_secondary | image_url: width: 800 }}" width="800" height="1067" alt="{{ card_title | escape }}" loading="lazy">{% endif %}
      {% else %}
        <div class="media-placeholder"></div>
      {% endif %}
    </a>
    <button class="wishlist-card" type="button" data-wishlist data-wishlist-handle="{{ product.handle }}{% if is_pack5 %}-5pack{% endif %}" data-wishlist-url="{{ card_url }}" data-wishlist-title="{{ card_title | escape }}" data-wishlist-image="{% if card_primary != blank %}{{ card_primary | image_url: width: 180 }}{% endif %}" data-wishlist-price="{{ card_price | money | escape }}" data-wishlist-compare-price="{% if card_compare_at_price > card_price %}{{ card_compare_at_price | money | escape }}{% endif %}" data-wishlist-variant-id="{{ card_variant.id }}" data-wishlist-variant-title="{% unless card_variant.title == 'Default Title' %}{{ card_variant.title | escape }}{% endunless %}"{% if rating_value != blank %} data-wishlist-rating="{{ rating_value | escape }}"{% endif %}{% if rating_count != blank %} data-wishlist-rating-count="{{ rating_count | escape }}"{% endif %} aria-label="Add {{ card_title | escape }} to favorites"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M7.5 3A5.5 5.5 0 0 0 2 8.5c0 1.085.136 1.99.527 2.851.386.849.984 1.574 1.766 2.356L10.586 20a2 2 0 0 0 2.828 0l6.293-6.293c.782-.782 1.38-1.507 1.766-2.356.391-.86.527-1.766.527-2.851A5.5 5.5 0 0 0 16.5 3c-1.805 0-3.265.776-4.221 1.807L12 5.086l-.279-.28C10.765 3.777 9.305 3 7.5 3Z"></path></svg></button>
    <button class="quick-shop" type="button" data-quick-open data-product-handle="{{ product.handle }}" aria-label="{{ 'products.card.quick_shop' | t }} {{ card_title | escape }}"{% unless product.available %} disabled{% endunless %}><span aria-hidden="true">+</span></button>
  </div>
  <div class="product-card__meta">
    <a class="product-card__vendor" href="{{ card_url }}">{{ card_vendor | default: shop.name }}</a>
    <a class="product-card__title" href="{{ card_url }}">{{ card_title }}</a>
    {% if rating_value != blank %}<a class="product-card__rating" href="{{ card_url }}#product-reviews" aria-label="{{ rating_value }} out of 5 stars{% if rating_count != blank %}, {{ rating_count }} reviews{% endif %}"><span class="stars" aria-hidden="true">★★★★★</span><b>{{ rating_value }}</b>{% if rating_count != blank %}<span>({{ rating_count }})</span>{% endif %}</a>{% endif %}
    <p class="product-card__subtitle">{% if is_pack5 %}Value 5-Pack{% if discount_percent > 0 %} · Save {{ discount_percent }}%{% endif %}{% else %}{% if card_fabric != blank %}{{ card_fabric }} · {% endif %}{{ product.type | default: 'Everyday essential' }}{% endif %}</p>
    <div class="product-card__price">{% render 'price', product: product, variant: card_variant %}</div>
    {% if show_color_options and color_opt_index >= 0 %}
      {%- assign seen_colors = '||' -%}
      {%- assign color_list_str = '' -%}
      {%- for v in product.variants -%}
        {%- assign include_v = true -%}
        {%- if pack_opt_index >= 0 -%}
          {%- assign v_pack_down = v.options[pack_opt_index] | downcase -%}
          {%- unless v_pack_down contains 'single' or v_pack_down == '1-pack' or v_pack_down == '1 pack' -%}
            {%- assign include_v = false -%}
          {%- endunless -%}
        {%- endif -%}
        {%- if include_v -%}
          {%- assign c_val = v.options[color_opt_index] | strip -%}
          {%- assign c_token = '||' | append: c_val | append: '||' -%}
          {%- unless seen_colors contains c_token -%}
            {%- assign seen_colors = seen_colors | append: c_val | append: '||' -%}
            {%- if color_list_str != '' -%}{%- assign color_list_str = color_list_str | append: '|||' -%}{%- endif -%}
            {%- assign color_list_str = color_list_str | append: c_val -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign card_colors = color_list_str | split: '|||' -%}
      {%- if card_colors.size > 0 -%}
        <div class="product-card__colors" aria-label="{{ card_colors.size }} color options">
          {%- for value in card_colors limit: 6 -%}
            <span class="color-dot" data-color="{{ value | handle }}" title="{{ value | escape }}"></span>
          {%- endfor -%}
          {%- if card_colors.size > 6 -%}<span class="color-more">+{{ card_colors.size | minus: 6 }}</span>{%- endif -%}
        </div>
      {%- endif -%}
    {% endif %}
    {% if settings.card_promo_code != blank %}<span class="product-card__promo">Code: {{ settings.card_promo_code | escape }}</span>{% endif %}
  </div>
</article>
{%- endif -%}
