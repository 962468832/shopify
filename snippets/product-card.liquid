<article class="product-card{% if product.images[1] %} product-card--has-secondary{% endif %}">
  {% assign card_variant = product.selected_or_first_available_variant | default: product.variants.first %}
  {% assign card_price = card_variant.price | default: product.price %}
  {% assign card_compare_at_price = card_variant.compare_at_price | default: 0 %}
  {% assign rating_value = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value | default: product.metafields.reviews.rating %}
  {% assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count %}
  {% assign discount_percent = 0 %}
  {% if card_compare_at_price > card_price %}{% assign discount_percent = card_compare_at_price | minus: card_price | times: 100.0 | divided_by: card_compare_at_price | round %}{% endif %}
  <div class="product-card__media">
    {% if discount_percent > 0 %}<span class="badge">Sale</span>{% endif %}
    <a href="{{ product.url }}">{% if product.featured_image %}<img class="product-card__image product-card__image--primary" src="{{ product.featured_image | image_url: width: 700 }}" width="700" height="933" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">{% if product.images[1] %}<img class="product-card__image product-card__image--secondary" src="{{ product.images[1] | image_url: width: 700 }}" width="700" height="933" alt="{{ product.images[1].alt | default: product.title | escape }}" loading="lazy">{% endif %}{% else %}<div class="media-placeholder"></div>{% endif %}</a>
    <button class="wishlist-card" type="button" data-wishlist data-wishlist-handle="{{ product.handle }}" data-wishlist-url="{{ product.url }}" data-wishlist-title="{{ product.title | escape }}" data-wishlist-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 180 }}{% endif %}" data-wishlist-price="{{ card_price | money | escape }}" data-wishlist-compare-price="{% if card_compare_at_price > card_price %}{{ card_compare_at_price | money | escape }}{% endif %}" data-wishlist-variant-id="{{ card_variant.id }}" data-wishlist-variant-title="{% unless card_variant.title == 'Default Title' %}{{ card_variant.title | escape }}{% endunless %}"{% if rating_value != blank %} data-wishlist-rating="{{ rating_value | escape }}"{% endif %}{% if rating_count != blank %} data-wishlist-rating-count="{{ rating_count | escape }}"{% endif %} aria-label="Add {{ product.title | escape }} to favorites"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M7.5 3A5.5 5.5 0 0 0 2 8.5c0 1.085.136 1.99.527 2.851.386.849.984 1.574 1.766 2.356L10.586 20a2 2 0 0 0 2.828 0l6.293-6.293c.782-.782 1.38-1.507 1.766-2.356.391-.86.527-1.766.527-2.851A5.5 5.5 0 0 0 16.5 3c-1.805 0-3.265.776-4.221 1.807L12 5.086l-.279-.28C10.765 3.777 9.305 3 7.5 3Z"></path></svg></button>
    <button class="quick-shop" type="button" data-quick-open data-product-handle="{{ product.handle }}"{% unless product.available %} disabled{% endunless %}>Quick shop</button>
  </div>
  <div class="product-card__meta"><a class="product-card__vendor" href="{{ product.url }}">{{ product.vendor | default: 'Nuage' }}</a><a class="product-card__title" href="{{ product.url }}">{{ product.title }}</a><p class="product-card__subtitle">{{ product.type | default: 'Comfort-first essential' }}</p>{% if rating_value != blank %}<a class="product-card__rating" href="{{ product.url }}#product-reviews" aria-label="{{ rating_value }} out of 5 stars{% if rating_count != blank %}, {{ rating_count }} reviews{% endif %}"><span aria-hidden="true">★★★★★</span> <b>{{ rating_value }}</b>{% if rating_count != blank %}<span>({{ rating_count }})</span>{% endif %}</a>{% endif %}{% if show_color_options %}{% for option in product.options_with_values %}{% assign option_name = option.name | downcase %}{% if option_name == 'color' or option_name == 'colour' %}<div class="product-card__colors" aria-label="{{ option.values.size }} color options">{% for value in option.values limit: 5 %}<span class="color-dot" data-color="{{ value | handle }}" title="{{ value }}"></span>{% endfor %}{% if option.values.size > 5 %}<span class="color-more">+{{ option.values.size | minus: 5 }}</span>{% endif %}<span class="color-count">{{ option.values.size }} colors</span></div>{% endif %}{% endfor %}{% endif %}<div class="product-card__price">{% render 'price', product: product, variant: card_variant %}</div></div>
</article>
