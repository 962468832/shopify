<article class="product-card">
  <div class="product-card__media">
    {% if product.compare_at_price > product.price %}<span class="badge">Bundle &amp; save</span>{% endif %}
    <a href="{{ product.url }}">{% if product.featured_image %}<img class="product-card__image product-card__image--primary" src="{{ product.featured_image | image_url: width: 700 }}" width="700" height="933" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">{% if product.images[1] %}<img class="product-card__image product-card__image--secondary" src="{{ product.images[1] | image_url: width: 700 }}" width="700" height="933" alt="{{ product.images[1].alt | default: product.title | escape }}" loading="lazy">{% endif %}{% else %}<div class="media-placeholder"></div>{% endif %}</a>
    <button class="wishlist-card" type="button" data-wishlist data-wishlist-handle="{{ product.handle }}" data-wishlist-url="{{ product.url }}" data-wishlist-title="{{ product.title | escape }}" data-wishlist-image="{% if product.featured_image %}{{ product.featured_image | image_url: width: 180 }}{% endif %}" data-wishlist-price="{{ product.price | money | escape }}" aria-label="Add {{ product.title | escape }} to wishlist"><span aria-hidden="true">♡</span></button>
    <button class="quick-shop" type="button" data-quick-open data-product-handle="{{ product.handle }}"{% unless product.available %} disabled{% endunless %}>Quick shop</button>
  </div>
  <div class="product-card__meta"><a class="product-card__vendor" href="{{ product.url }}">{{ product.vendor | default: 'Nuage' }}</a><a class="product-card__title" href="{{ product.url }}">{{ product.title }}</a><p class="product-card__subtitle">{{ product.type | default: 'Comfort-first essential' }}</p>{% if show_color_options %}{% for option in product.options_with_values %}{% assign option_name = option.name | downcase %}{% if option_name == 'color' %}<div class="product-card__colors" aria-label="{{ option.values.size }} color options">{% for value in option.values limit: 5 %}<span class="color-dot" data-color="{{ value | handle }}" title="{{ value }}"></span>{% endfor %}{% if option.values.size > 5 %}<span class="color-more">+{{ option.values.size | minus: 5 }}</span>{% endif %}<span class="color-count">{{ option.values.size }} colors</span></div>{% endif %}{% endfor %}{% endif %}<div class="product-card__price">{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</div></div>
</article>
