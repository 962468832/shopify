<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{% liquid
      assign title_parts = page_title
      if current_tags
        assign title_tags = current_tags | join: ', '
        assign title_parts = title_parts | append: ' – ' | append: title_tags
      endif
      if current_page != 1
        assign title_parts = title_parts | append: ' – Page ' | append: current_page
      endif
      if request.page_type == 'index' or page_title == blank
        echo shop.name
      elsif title_parts contains shop.name
        echo title_parts
      else
        echo title_parts | append: ' | ' | append: shop.name
      endif
    %}</title>
    {% assign meta_description = page_description | default: shop.description | default: shop.name %}
    <meta name="description" content="{{ meta_description | strip_html | escape }}">
    {% render 'meta-tags' %}
    {% render 'favicon' %}
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@400;500;600&display=swap">
    <link rel="dns-prefetch" href="https://cdn.shopify.com">
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {%- if template.name == 'index' -%}
      {{ 'home.css' | asset_url | stylesheet_tag }}
    {%- else -%}
      {%- comment -%} home.css only styles the homepage blocks; keep it off the critical path elsewhere. {%- endcomment -%}
      <link rel="stylesheet" href="{{ 'home.css' | asset_url }}" media="print" onload="this.media='all'">
      <noscript><link rel="stylesheet" href="{{ 'home.css' | asset_url }}"></noscript>
    {%- endif -%}
    {% style %}
      {{ settings.heading_font | font_face: font_display: 'swap' }}
      {{ settings.body_font | font_face: font_display: 'swap' }}
      :root{--ink:{{ settings.color_ink | default: '#392e28' }};--paper:{{ settings.color_paper | default: '#f8f3ea' }};--accent:{{ settings.color_accent | default: '#79474d' }};--line:{{ settings.color_line | default: '#e5d4bf' }};--heading-font:{{ settings.heading_font.family | default: 'Playfair Display' | json }};--body-font:{{ settings.body_font.family | default: 'DM Sans' | json }};}:root{--heading-font:'Cormorant Garamond';--body-font:'DM Sans';}
    {% endstyle %}
  </head>
  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>
    {% section 'announcement-bar' %}
    {% section 'header' %}
    <main id="MainContent" role="main">{% if request.page_type == 'policy' and request.path contains 'refund-policy' or request.page_type == 'policy' and request.path contains 'shipping-policy' or request.page_type == 'policy' and request.path contains 'privacy-policy' or request.page_type == 'policy' and request.path contains 'terms-of-service' %}{% render 'policy-content' %}{% else %}{{ content_for_layout }}{% endif %}</main>
    {% section 'footer' %}
    <div class="cart-feedback" data-cart-feedback hidden><p role="status" aria-live="polite" aria-atomic="true" data-cart-feedback-message></p><a href="{{ routes.cart_url }}">{{ 'cart.view_bag' | t }} →</a><button type="button" data-cart-feedback-close aria-label="Dismiss notification">×</button></div>
    <div id="cart-drawer" class="cart-drawer" aria-hidden="true">
      <div class="cart-drawer__backdrop" data-cart-close></div>
      <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Shopping bag">
        <header class="cart-drawer__head">
          <div><p class="eyebrow">{{ 'cart.title' | t }}</p><h2>{{ 'cart.shopping_bag' | t }}</h2></div>
          <div class="cart-drawer__head-actions"><a class="text-link" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a><button class="icon-button" type="button" data-cart-close aria-label="Close cart">&times;</button></div>
        </header>
        <div class="cart-drawer__body" data-cart-drawer-body>
          <div class="cart-progress" data-cart-progress hidden>
            <div class="cart-progress__label"><span data-cart-progress-label>{{ 'cart.unlock_shipping' | t }}</span><strong data-cart-progress-remaining></strong></div>
            <div class="cart-progress__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span data-cart-progress-bar></span></div>
          </div>
          <div class="cart-items" data-cart-items><p class="empty-state">{{ 'cart.empty' | t }}.</p></div>
          <form class="cart-discount" data-cart-discount>
            <label for="CartDiscountCode">{{ 'cart.discount_code' | t }}</label>
            <div><input id="CartDiscountCode" type="text" name="code" autocomplete="off" placeholder="{{ 'cart.enter_code' | t }}"><button class="button button--dark" type="submit">{{ 'cart.apply' | t }}</button></div>
            <p data-cart-discount-message role="status"></p>
          </form>
          <section class="cart-recommendations" data-cart-recommendations aria-labelledby="CartRecommendationsTitle" hidden>
            <header><h3 id="CartRecommendationsTitle">{{ 'products.recommendations' | t }}</h3></header>
            <div class="cart-recommendations__grid" data-cart-recommendation-items></div>
          </section>
          <section class="cart-summary" data-cart-summary>
            <div><span>{{ 'cart.subtotal' | t }}</span><strong data-cart-subtotal>{{ cart.items_subtotal_price | money }}</strong></div>
            <div class="cart-summary__savings" data-cart-savings-row hidden><span>{{ 'cart.you_save' | t }}</span><strong data-cart-savings-total></strong></div>
            {%- assign cart_level_discount = 0 -%}{%- for discount_application in cart.cart_level_discount_applications -%}{%- assign cart_level_discount = cart_level_discount | plus: discount_application.total_allocated_amount -%}{%- endfor -%}
            <div data-cart-discount-row{% if cart_level_discount == 0 %} hidden{% endif %}><span>{{ 'cart.discount' | t }}</span><strong data-cart-discount-total>–{{ cart_level_discount | money }}</strong></div>
            <div><span>{{ 'cart.total' | t }}</span><strong data-cart-total>{{ cart.total_price | money }}</strong></div>
            <p>{{ 'cart.taxes_note' | t }}</p>
          </section>
        </div>
        <footer class="cart-drawer__foot">
          <a class="button button--dark button--full" data-cart-checkout href="{{ routes.cart_url }}/checkout">{{ 'cart.checkout' | t }}</a>
          <button class="text-link" type="button" data-cart-close>{{ 'cart.continue' | t }}</button>
        </footer>
      </aside>
    </div>
    <div id="quick-shop" class="quick-shop-modal" aria-hidden="true">
      <div class="quick-shop-modal__backdrop" data-quick-close></div>
      <section class="quick-shop-modal__panel" role="dialog" aria-modal="true" aria-labelledby="QuickShopTitle">
        <header class="quick-shop-modal__head"><p class="eyebrow">{{ 'products.card.quick_shop' | t }}</p><button class="icon-button" type="button" data-quick-close aria-label="Close quick shop">&times;</button></header>
        <div class="quick-shop-modal__body" data-quick-shop-body><p class="empty-state">{{ 'products.loading_options' | t }}</p></div>
      </section>
    </div>
    {% render 'fit-size-guide' %}
    <div class="float-bar" data-float-bar>
      <button class="float-toggle" type="button" data-float-toggle aria-controls="wishlist-drawer" aria-expanded="true" aria-label="Tuck the favorites and contact shortcuts to the edge"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></button>
      <button class="wishlist-launcher" type="button" data-wishlist-open aria-label="Open favorites">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill-rule="evenodd" clip-rule="evenodd" d="M7.5 3A5.5 5.5 0 0 0 2 8.5c0 1.085.136 1.99.527 2.851.386.849.984 1.574 1.766 2.356L10.586 20a2 2 0 0 0 2.828 0l6.293-6.293c.782-.782 1.38-1.507 1.766-2.356.391-.86.527-1.766.527-2.851A5.5 5.5 0 0 0 16.5 3c-1.805 0-3.265.776-4.221 1.807L12 5.086l-.279-.28C10.765 3.777 9.305 3 7.5 3Z"></path></svg>
        <span data-wishlist-count>0</span>
      </button>
      <button class="float-contact" type="button" data-float-contact aria-label="Chat with us" hidden>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8.5Z"></path></svg>
        <span>{{ 'footer.contact' | t }}</span>
      </button>
      <button class="float-edge-tab" type="button" data-float-tab aria-label="Show the favorites and contact shortcuts" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg></button>
    </div>
<div id="wishlist-drawer" class="cart-drawer wishlist-drawer" aria-hidden="true">
      <div class="cart-drawer__backdrop" data-wishlist-close></div>
      <aside class="cart-drawer__panel wishlist-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="WishlistDrawerTitle">
        <header class="wishlist-drawer__head">
          <button class="icon-button" type="button" data-wishlist-close aria-label="Go back"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></button>
          <h2 id="WishlistDrawerTitle">{{ 'favorites.title' | t }}</h2>
          <button class="icon-button" type="button" data-wishlist-close aria-label="Close favorites"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg></button>
        </header>
        <div class="wishlist-drawer__body" data-wishlist-body><button class="wishlist-drawer__share" type="button" data-wishlist-share>{{ 'favorites.share' | t }}</button><p class="empty-state">{{ 'favorites.empty' | t }}</p></div>
      </aside>
    </div>
    {%- assign is_zh_layout = false -%}{%- if request.locale.iso_code contains 'zh' -%}{%- assign is_zh_layout = true -%}{%- endif -%}
    <script>window.PielikShopName={{ shop.name | capitalize | json }};window.ShopifyRoutes={cartAdd:'{{ routes.cart_add_url }}',cartChange:'{{ routes.cart_change_url }}',cartUpdate:'{{ routes.cart_update_url }}',cartJson:'{{ routes.cart_url }}.js',cartUrl:'{{ routes.cart_url }}',checkoutUrl:'{{ routes.cart_url }}/checkout',allProductsUrl:'{{ routes.all_products_collection_url }}',predictiveSearchUrl:'{{ routes.predictive_search_url }}',rootUrl:'{{ routes.root_url }}'};window.PielikMoney={format:{{ shop.money_format | json }},currency:{{ cart.currency.iso_code | json }},baseCurrency:{{ shop.currency | json }},locale:{{ request.locale.iso_code | json }},rate:Number({{ cart.currency.rate | default: 1 | json }}) || 1};window.PielikThemeSettings={cartProgressThreshold:{{ settings.cart_progress_threshold | default: 0 | json }},cartProgressLabel:{% if is_zh_layout %}{{ 'cart.unlock_shipping' | t | json }}{% else %}{{ settings.cart_progress_label | default: 'Unlock free shipping' | json }}{% endif %},cartProgressCompleteLabel:{% if is_zh_layout %}{{ 'cart.free_shipping_unlocked' | t | json }}{% else %}{{ settings.cart_progress_complete_label | default: 'Free shipping unlocked' | json }}{% endif %},cookiePreferencesUrl:{{ settings.cookie_preferences_url | default: '/policies/privacy-policy' | json }}};window.PielikCopy={cartAdded:{{ 'cart.added' | t | json }},cartError:{{ 'cart.error' | t | json }},cartEmpty:{{ 'cart.empty' | t | json }},discountApplied:{{ 'cart.discount_applied' | t | json }},discountInvalid:{{ 'cart.discount_invalid' | t | json }},discountNotApplicable:{{ 'cart.discount_not_applicable' | t | json }},enterCodeError:{{ 'cart.enter_code_error' | t | json }},apply:{{ 'cart.apply' | t | json }},unlocked:{{ 'cart.unlocked' | t | json }},away:{{ 'cart.away' | t | json }},edit:{{ 'cart.edit' | t | json }},remove:{{ 'cart.remove' | t | json }},sizeGuide:{{ 'products.product.size_guide' | t | json }},save:{{ 'products.product.save' | t | json }},checkout:{{ 'cart.checkout' | t | json }},shopNow:{{ 'cart.shop_now' | t | json }},add:{{ 'cart.add' | t | json }},adding:{{ 'cart.adding' | t | json }},addedShort:{{ 'cart.added_short' | t | json }},loadingBag:{{ 'cart.loading_bag' | t | json }},loadingRecs:{{ 'cart.loading_recs' | t | json }},loadingOptions:{{ 'products.loading_options' | t | json }},quickShop:{{ 'products.card.quick_shop' | t | json }},sale:{{ 'products.card.sale' | t | json }},colors:{{ 'products.card.colors' | t | json }},select:{{ 'products.product.select' | t | json }},qty:{{ 'cart.qty' | t | json }},updateBag:{{ 'cart.update' | t | json }},updatedBag:{{ 'cart.updated_bag' | t | json }},addToBag:{{ 'products.product.add_to_cart' | t | json }},soldOut:{{ 'products.product.sold_out' | t | json }},buyNow:{{ 'products.product.buy_now' | t | json }},unavailable:{{ 'products.product.unavailable' | t | json }},loading:{{ 'products.product.loading' | t | json }},inStock:{{ 'products.product.in_stock' | t | json }},soldOutMsg:{{ 'products.product.sold_out_msg' | t | json }},unavailableMsg:{{ 'products.product.unavailable_msg' | t | json }},includes:{{ 'products.product.includes' | t | json }},noProducts:{{ 'collection.no_products' | t | json }},shareList:{{ 'favorites.share' | t | json }},favoritesEmpty:{{ 'favorites.empty' | t | json }},addToCart:{{ 'favorites.add_to_cart' | t | json }},addedToCart:{{ 'favorites.added_to_cart' | t | json }},linkCopied:{{ 'favorites.link_copied' | t | json }},enterHip:{{ 'size.enter_hip' | t | json }}};</script>
    {% if request.page_type == 'customers/addresses' %}<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer></script>{% endif %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    {% if request.page_type contains 'customers/' %}<script src="{{ 'customer.js' | asset_url }}" defer></script>{% endif %}
    <script src="{{ 'home.js' | asset_url }}" defer></script>
    {% if request.page_type == 'product' %}<script src="{{ 'product.js' | asset_url }}" defer></script>{% endif %}
  </body>
</html>
