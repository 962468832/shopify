<header class="site-header{% if template.name == 'index' %} site-header--home{% else %} site-header--solid{% endif %}" data-header>
  <div class="site-header__inner">
    <button class="menu-toggle icon-button" data-menu-toggle aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
    {% assign primary_menu = section.settings.menu | default: linklists['main-menu'] %}
    <nav class="site-nav site-nav--left" data-mobile-nav aria-label="Main navigation">
      {% if section.settings.use_storefront_menu and primary_menu != blank %}
        {% for link in primary_menu.links %}
          {% if link.links != blank %}
            <div class="nav-mega nav-mega--secondary" data-nav-mega>
              <a class="nav-mega__trigger" href="{{ link.url }}" aria-haspopup="true" aria-expanded="false">{{ link.title }}</a>
              <div class="mega-menu mega-menu--secondary" aria-label="{{ link.title | escape }}">
                <div class="mega-menu__mobile-section">
                  <button class="mega-menu__section-trigger" type="button" data-mobile-submenu-toggle aria-expanded="true">{{ link.title }} <span aria-hidden="true">⌃</span></button>
                  <div class="mega-menu__mobile-links is-open" data-mobile-submenu>
                    {% for child_link in link.links %}<a href="{{ child_link.url }}">{{ child_link.title }}</a>{% endfor %}
                  </div>
                </div>
              </div>
            </div>
          {% else %}
            <a class="nav-mega nav-mega--simple" href="{{ link.url }}">{{ link.title }}</a>
          {% endif %}
        {% endfor %}
      {% else %}
      {%- comment -%} Built-in Pielik navigation. Links to collections that have no products are hidden. {%- endcomment -%}
      {% liquid
        assign all_url = routes.all_products_collection_url
        assign c_best = collections['best-sellers-2026']
        assign c_new = collections['new-arrivals-2026']
        assign c_undies = collections['undies-2026']
        assign c_feather = collections['featherlight-collection']
        assign c_sculpt = collections['sculpt-lift']
        assign c_bras = collections['bras-2026']
        assign sale_collection = collections['sale-2026']
        assign feather_image = section.settings.menu_nucloud_image | default: c_feather.image | default: c_feather.products.first.featured_image
        assign sculpt_image = section.settings.menu_nuair_image | default: c_sculpt.image | default: c_sculpt.products.first.featured_image
        assign style_handles = 'mid-rise-brief,high-rise,thongs' | split: ','
        assign style_labels = 'Briefs,High-Rise,Thongs' | split: ','
        assign solution_handles = 'no-vpls,no-wedgies,no-digging,no-rolling,breathable-all-day,anticamel-toe' | split: ','
        assign solution_labels = 'No Visible Lines,No Wedgies,No Digging,No Rolling,Breathable All Day,Anti Camel-Toe' | split: ','
      %}
      <div class="nav-mega nav-mega--underwear" data-nav-mega>
        <a class="nav-mega__trigger" href="{{ c_undies.url | default: all_url }}" aria-haspopup="true" aria-expanded="false">Underwear</a>
        <div class="mega-menu mega-menu--underwear" aria-label="Underwear collections">
          <div class="mega-menu__feature"><p class="eyebrow">Featured Collection</p>{% if c_best.products_count > 0 %}<a href="{{ c_best.url }}">Best Sellers</a>{% endif %}{% if c_new.products_count > 0 %}<a href="{{ c_new.url }}">New Arrivals</a>{% endif %}<a href="{{ all_url }}">Shop All</a></div>
          <div class="mega-menu__mobile-section"><button class="mega-menu__section-trigger" type="button" data-mobile-submenu-toggle aria-expanded="true">Shop by Style <span aria-hidden="true">⌃</span></button><p class="eyebrow mega-menu__desktop-label">Shop by Style</p><div class="mega-menu__mobile-links is-open" data-mobile-submenu><a href="{{ c_undies.url | default: all_url }}">Shop All Underwear</a>{% for h in style_handles %}{% assign c = collections[h] %}{% if c.products_count > 0 %}<a href="{{ c.url }}">{{ style_labels[forloop.index0] }}</a>{% endif %}{% endfor %}</div></div>
          <div class="mega-menu__mobile-section"><button class="mega-menu__section-trigger" type="button" data-mobile-submenu-toggle aria-expanded="false">Shop by Solution <span aria-hidden="true">⌄</span></button><p class="eyebrow mega-menu__desktop-label">Shop by Solution</p><div class="mega-menu__mobile-links" data-mobile-submenu>{% for h in solution_handles %}{% assign c = collections[h] %}{% if c.products_count > 0 %}<a href="{{ c.url }}">{{ solution_labels[forloop.index0] }}</a>{% endif %}{% endfor %}</div></div>
          <a class="mega-menu__tile{% if feather_image != blank %} mega-menu__tile--image{% endif %}" href="{{ c_feather.url | default: all_url }}">{% if feather_image != blank %}<img src="{{ feather_image | image_url: width: 500 }}" width="340" height="410" alt="" loading="lazy">{% endif %}<span>Featherlight<small>Explore collection →</small></span></a>
          <a class="mega-menu__tile mega-menu__tile--air{% if sculpt_image != blank %} mega-menu__tile--image{% endif %}" href="{{ c_sculpt.url | default: all_url }}">{% if sculpt_image != blank %}<img src="{{ sculpt_image | image_url: width: 500 }}" width="340" height="410" alt="" loading="lazy">{% endif %}<span>Sculpt &amp; Lift<small>Explore collection →</small></span></a>
        </div>
      </div>
      {% if c_bras.products_count > 0 %}
      {% liquid
        assign bra_featured = c_bras.products.first
        assign bra_pair = all_products['featherlight-seamless-brief'] | default: c_bras.products[1]
        assign bra_featured_image = section.settings.menu_bra_featured_image | default: bra_featured.featured_image
        assign bra_pair_image = section.settings.menu_wireless_bra_image | default: bra_pair.featured_image
      %}
      <div class="nav-mega nav-mega--secondary nav-mega--bra" data-nav-mega>
        <a class="nav-mega__trigger" href="{{ c_bras.url }}" aria-haspopup="true" aria-expanded="false">Bras</a>
        <div class="mega-menu mega-menu--bra" aria-label="Bra collections">
          <div class="mega-menu__feature"><p class="eyebrow">Featured Collection</p>{% if c_best.products_count > 0 %}<a href="{{ c_best.url }}">Best Sellers</a>{% endif %}{% if c_new.products_count > 0 %}<a href="{{ c_new.url }}">New Arrivals</a>{% endif %}</div>
          <div class="mega-menu__mobile-section"><button class="mega-menu__section-trigger" type="button" data-mobile-submenu-toggle aria-expanded="true">Bras <span aria-hidden="true">⌃</span></button><p class="eyebrow mega-menu__desktop-label">Bras</p><div class="mega-menu__mobile-links is-open" data-mobile-submenu><a href="{{ c_bras.url }}">Shop All Bras</a>{% for product in c_bras.products limit: 4 %}<a href="{{ product.url }}">{{ product.title }}</a>{% endfor %}{% if c_sculpt.products_count > 0 %}<a href="{{ c_sculpt.url }}">Sculpt &amp; Lift</a>{% endif %}</div></div>
          {% if bra_featured != blank %}<a class="mega-menu__tile{% if bra_featured_image != blank %} mega-menu__tile--image{% endif %}" href="{{ bra_featured.url }}">{% if bra_featured_image != blank %}<img src="{{ bra_featured_image | image_url: width: 500 }}" width="340" height="410" alt="{{ bra_featured.title | escape }}" loading="lazy">{% endif %}<span>{{ bra_featured.title }}<small>{{ bra_featured.price | money }} <span aria-hidden="true">↗</span></small></span></a>{% endif %}
          {% if bra_pair != blank %}<a class="mega-menu__tile{% if bra_pair_image != blank %} mega-menu__tile--image{% endif %}" href="{{ bra_pair.url }}">{% if bra_pair_image != blank %}<img src="{{ bra_pair_image | image_url: width: 500 }}" width="340" height="410" alt="{{ bra_pair.title | escape }}" loading="lazy">{% endif %}<span>Pair it with {{ bra_pair.title }}<small>{{ bra_pair.price | money }} <span aria-hidden="true">↗</span></small></span></a>{% endif %}
        </div>
      </div>
      {% endif %}
      {% if c_sculpt.products_count > 0 %}<a class="nav-mega nav-mega--simple" href="{{ c_sculpt.url }}">Shapewear</a>{% endif %}
      {% if sale_collection.products_count > 0 %}
      <div class="nav-mega nav-mega--sale" data-nav-mega><a class="site-nav__sale nav-mega__trigger" href="{{ sale_collection.url }}" aria-haspopup="true" aria-expanded="false">Last Chance</a><div class="mega-menu mega-menu--sale" aria-label="Last Chance offers"><div><p class="eyebrow">Last Chance</p><a href="{{ sale_collection.url }}">Shop all sale</a><a href="{{ sale_collection.url }}?sort_by=price-ascending">Lowest prices</a><a href="{{ sale_collection.url }}?sort_by=best-selling">Sale best sellers</a></div><div class="mega-menu__sale-products"><p class="eyebrow">Final markdowns</p>{% for product in sale_collection.products limit: 4 %}<a class="sale-product-link" href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 120 }}" width="120" height="150" alt="" loading="lazy">{% endif %}<span>{{ product.title }}<small>{{ product.price | money }}</small></span></a>{% endfor %}</div></div></div>
      {% endif %}
      <div class="mobile-featured-collection"><p class="mobile-featured-collection__title">Featured Collection</p><div class="mobile-featured-collection__grid">{% assign featured_handles = 'featherlight-collection,sculpt-lift' | split: ',' %}{% for featured_handle in featured_handles %}{% assign featured_collection = collections[featured_handle] %}{% if featured_collection.products_count > 0 %}{% assign featured_image = featured_collection.image | default: featured_collection.products.first.featured_image %}<a href="{{ featured_collection.url }}">{% if featured_image %}<img src="{{ featured_image | image_url: width: 720 }}" width="720" height="540" alt="{{ featured_collection.title | escape }}" loading="lazy">{% endif %}<span>{{ featured_collection.title }}</span></a>{% endif %}{% endfor %}</div><div class="mobile-featured-collection__links">{% if c_best.products_count > 0 %}<a href="{{ c_best.url }}">Best Sellers</a>{% endif %}<a href="{{ all_url }}">Shop All</a></div></div>
      {% endif %}
    </nav>
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">{% render 'brand-logo', variant: 'light', class: 'brand-logo brand-logo--light' %}{% render 'brand-logo', variant: 'dark', class: 'brand-logo brand-logo--dark' %}</a>
    <nav class="site-nav site-nav--right" aria-label="Store actions"><button class="icon-button" data-search-toggle aria-label="Search" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"></circle><path d="m16 16 5 5"></path></svg></button><button class="icon-button currency-trigger" data-currency-toggle aria-label="Select currency"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg></button><a class="icon-button account-trigger" href="{{ routes.account_url }}" aria-label="Sign in"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></a><button class="icon-button cart-trigger" data-cart-open aria-label="Cart ({{ cart.item_count }} items)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v10h16V10"></path><path d="m3 10 2-6h14l2 6"></path><path d="M3 10a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"></path><path d="M10 20v-5h4v5"></path></svg><sup data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</sup></button></nav>
  </div>
  <div class="currency-panel" data-currency-panel aria-hidden="true">{% form 'localization', id: 'HeaderCurrencyForm', class: 'currency-form' %}<label for="HeaderCountry">Country and currency</label><select id="HeaderCountry" name="country_code" data-currency-select>{% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name }} · {{ country.currency.iso_code }}</option>{% endfor %}</select>{% endform %}</div>
  <div class="search-panel" data-search-panel aria-hidden="true"><form action="{{ routes.search_url }}" method="get" role="search" data-search-form><label for="SearchInput">Search products</label><input id="SearchInput" name="q" type="search" placeholder="Search products..." autocomplete="off" data-predictive-search-input><input type="hidden" name="type" value="product,article,page"><button class="button button--dark" type="submit">Search</button></form><div class="predictive-results" data-predictive-results aria-live="polite"></div></div>
</header>
{% schema %}
{"name":"Header","settings":[{"type":"checkbox","id":"use_storefront_menu","label":"Use Shopify menu instead of built-in navigation","default":false},{"type":"link_list","id":"menu","label":"Shopify menu (optional)"},{"type":"header","content":"Underwear 浮动菜单"},{"type":"image_picker","id":"menu_nucloud_image","label":"Featherlight 卡片图片","info":"留空时保留当前系列图片。"},{"type":"image_picker","id":"menu_nuair_image","label":"Sculpt & Lift 卡片图片","info":"留空时保留当前系列图片。"},{"type":"header","content":"Bras 卡片"},{"type":"image_picker","id":"menu_bra_featured_image","label":"文胸主推卡片图片","info":"留空时使用现有系列图片。"},{"type":"image_picker","id":"menu_wireless_bra_image","label":"搭配推荐卡片图片","info":"留空时使用现有系列图片。"}]}
{% endschema %}
