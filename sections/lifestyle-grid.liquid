<section class="home-section home-lifestyles" data-home-carousel>
  <div class="home-container">
    <div class="home-heading">
      <div>
        <p class="home-eyebrow">{% render 'i18n', text: section.settings.eyebrow %}</p>
        <h2>{% render 'i18n', text: section.settings.heading %}</h2>
      </div>
    </div>
    <div class="home-lifestyle-grid{% if section.blocks.size == 3 %} home-lifestyle-grid--3{% endif %}" data-home-rail tabindex="0" role="region" aria-label="{% render 'i18n', text: section.settings.heading %}">
      {% for block in section.blocks %}
        {% assign ls_href = block.settings.link | default: routes.all_products_collection_url %}
        <article class="home-lifestyle" {{ block.shopify_attributes }}>
          {% if block.settings.video != blank or block.settings.video_url != blank %}
            {% render 'home-video', video: block.settings.video, video_url: block.settings.video_url, poster: block.settings.image, poster_url: block.settings.image_url, title: block.settings.title, mode: 'auto' %}
          {% else %}
            {% render 'home-image', image: block.settings.image, image_url: block.settings.image_url, title: block.settings.title, width: 800, height: 1067 %}
          {% endif %}
          <a class="home-lifestyle__link" href="{% render 'locale-url', url: ls_href %}" draggable="false">
            <p class="home-eyebrow">{% render 'i18n', text: block.settings.label %}</p>
            <h3>{% render 'i18n', text: block.settings.title %}</h3>
            <p>{% render 'i18n', text: block.settings.copy %}</p>
            {% if block.settings.button_label != blank %}<span class="home-text-link">{% render 'i18n', text: block.settings.button_label %} →</span>{% endif %}
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "生活方式视频卡片",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "上方小标题",
      "default": "Shop by Lifestyle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Built for how you actually live."
    }
  ],
  "presets": [
    {
      "name": "生活方式视频卡片",
      "blocks": [
        { "type": "lifestyle" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "lifestyle",
      "name": "生活方式卡片",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "视频",
          "info": "上传或选择竖版短视频，自动静音循环播放。"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "视频直链（可选）"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "封面图片",
          "info": "视频加载前显示的封面图，或无视频时的备用图。"
        },
        {
          "type": "checkbox",
          "id": "show_legacy_media",
          "label": "显示旧版素材地址",
          "default": false
        },
        {
          "type": "url",
          "id": "image_url",
          "label": "旧版图片地址",
          "visible_if": "{{ block.settings.show_legacy_media }}"
        },
        {
          "type": "text",
          "id": "label",
          "label": "标签"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Lifestyle"
        },
        {
          "type": "textarea",
          "id": "copy",
          "label": "描述"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "按钮文字",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接"
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
