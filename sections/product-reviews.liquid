<section id="product-reviews" class="product-reviews page-width" aria-labelledby="product-reviews-title">
  <div class="product-reviews__shell">
    <header class="product-reviews__header">
      <div>
        <p class="eyebrow">Reviews</p>
        <h2 id="product-reviews-title">{{ section.settings.heading | escape }}</h2>
        <p>{{ section.settings.description | escape }}</p>
      </div>
      {% if section.blocks.size > 0 %}
        <a class="button button--dark" href="#product-review-app">Write a review</a>
      {% endif %}
    </header>
    <div id="product-review-app" class="product-reviews__body">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% render block %}
        {% endfor %}
      {% else %}
        <div class="product-reviews__empty">
          <h3>Reviews coming soon</h3>
          <p>Customer reviews will appear here after the store review app is connected.</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What customers are saying"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Real notes on fit, feel and everyday wear from the people who live in Nuage."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Product reviews"
    }
  ]
}
{% endschema %}
