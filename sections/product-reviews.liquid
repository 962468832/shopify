{% if section.blocks.size > 0 or request.design_mode %}
  <section id="product-reviews" class="product-reviews product-reviews--judge-me page-width" aria-label="Product reviews">
    {% if section.blocks.size > 0 %}
      <div id="product-review-app" class="product-reviews__app">
        {% for block in section.blocks %}
          {% render block %}
        {% endfor %}
      </div>
    {% elsif request.design_mode %}
      <div class="product-reviews__empty">
        <h2 id="product-reviews-title">Judge.me reviews</h2>
        <p>Add the Judge.me Reviews Widget app block to this section to display ratings and customer reviews.</p>
      </div>
    {% endif %}
  </section>
{% endif %}

{% schema %}
{
  "name": "Product reviews",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Product reviews"
    }
  ]
}
{% endschema %}
