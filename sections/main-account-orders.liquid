<section class="page-width account-page">
  {% render 'account-sidebar' %}
  <div class="account-content">
    <header class="account-content__head">
      <p class="eyebrow">Orders</p>
      <h1>Order history</h1>
      <p>Every order placed with your account appears here.</p>
    </header>
    {% paginate customer.orders by 12 %}
      {% if customer.orders.size > 0 %}
        <div class="account-table account-table--orders" role="table">
          <div role="row"><span role="columnheader">Order</span><span role="columnheader">Date</span><span role="columnheader">Payment</span><span role="columnheader">Fulfillment</span><span role="columnheader">Total</span></div>
          {% for order in customer.orders %}
            <a href="{{ order.customer_url }}" role="row">
              <span role="cell"><strong>{{ order.name }}</strong><small>{{ order.created_at | date: '%b %-d, %Y' }}</small></span>
              <span role="cell">{{ order.created_at | date: '%b %-d, %Y' }}</span>
              <span role="cell">{{ order.financial_status_label }}</span>
              <span role="cell">{{ order.fulfillment_status_label }}</span>
              <span role="cell"><strong>{{ order.total_price | money }}</strong><small>View details</small></span>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <div class="empty-state account-empty"><p>You haven't placed any orders yet.</p><a class="button button--dark" href="{{ routes.all_products_collection_url }}">Start shopping</a></div>
      {% endif %}
      {% if paginate.pages > 1 %}<div class="account-pagination">{{ paginate | default_pagination }}</div>{% endif %}
    {% endpaginate %}
  </div>
</section>
{% schema %}{"name":"Customer orders","settings":[]}{% endschema %}
