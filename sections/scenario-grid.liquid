<section class="home-section home-scenarios" data-home-carousel>
  <div class="home-container"><div class="home-heading"><div><p class="home-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.link_label != blank %}<a class="home-text-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} →</a>{% endif %}</div>
  <div class="home-rail home-scenario-rail" data-home-rail tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}">
    {% for block in section.blocks %}<article class="home-scenario" {{ block.shopify_attributes }}>
      <div class="home-scenario__visual">{% render 'home-video', video: block.settings.video, video_url: block.settings.video_url, poster: block.settings.poster, poster_url: block.settings.poster_url, title: block.settings.title %}<span>{{ block.settings.kicker | escape }}</span></div>
      <a href="{{ block.settings.link | default: routes.all_products_collection_url }}"><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.copy | escape }}</p>{% if block.settings.button_label != blank %}<b class="home-text-link">{{ block.settings.button_label | escape }} →</b>{% endif %}</a>
    </article>{% endfor %}
  </div>{% render 'home-rail-controls', label:section.settings.heading %}</div>
</section>
{% schema %}
{
  "name": "场景视频卡片",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "上方小标题",
      "default": "Shop by Scenario"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "What's your biggest challenge?"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "入口文字",
      "default": "All Scenarios"
    },
    {
      "type": "url",
      "id": "link",
      "label": "入口链接"
    }
  ],
  "presets": [
    {
      "name": "场景视频卡片",
      "blocks": [
        {
          "type": "scenario"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "scenario",
      "name": "场景卡片",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "视频",
          "info": "从文件库选择或直接上传视频。未选择时沿用现有视频。"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "视频封面",
          "info": "不选封面时，使用所选视频的默认封面。"
        },
        {
          "type": "checkbox",
          "id": "show_legacy_media",
          "label": "显示旧版素材地址",
          "info": "仅兼容原有内容，日常更换素材请使用上方选择器。",
          "default": false
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "旧版视频地址",
          "visible_if": "{{ block.settings.show_legacy_media }}"
        },
        {
          "type": "url",
          "id": "poster_url",
          "label": "旧版封面地址",
          "visible_if": "{{ block.settings.show_legacy_media }}"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "集合标签"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Scenario"
        },
        {
          "type": "textarea",
          "id": "copy",
          "label": "描述"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "按钮文字",
          "default": "Shop the Solution"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
