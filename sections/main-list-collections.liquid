{%- liquid
  assign featured_handles = 'best-sellers-2026,softveil-collection,freeform-collection,undies-2026,no-vpls' | split: ','
  assign featured_found = false
  for handle in featured_handles
    if collections[handle] != blank
      assign featured_found = true
      break
    endif
  endfor
-%}
<section class="page-width list-collections-page">
  <header class="list-collections-page__head"><p class="eyebrow">{{ 'collection.explore_pielik' | t }}</p><h1>{{ 'collection.by_collection' | t }}</h1><p>{{ 'collection.fit_intro' | t }}</p></header>
  <div class="list-collections-grid">
    {% assign rendered = 0 %}
    {% if featured_found == false %}{% assign featured_handles = collections | map: 'handle' %}{% endif %}
    {% for handle in featured_handles %}{% assign collection = collections[handle] %}{% if collection.products_count > 0 %}{% assign rendered = rendered | plus: 1 %}{% assign collection_image = collection.image | default: collection.products.first.metafields.custom.model_card_image.value | default: collection.products.first.featured_image %}<a class="list-collections-card" href="{{ collection.url }}">{% if collection_image %}<img src="{{ collection_image | image_url: width: 900 }}" width="900" height="1125" alt="{% render 'i18n', text: collection.title %}" loading="lazy">{% else %}<span class="list-collections-card__placeholder" aria-hidden="true"></span>{% endif %}<div class="list-collections-card__copy"><h2>{% render 'i18n', text: collection.title %}</h2><p>{{ collection.products_count }} {{ 'collection.products_count_label' | t }}</p></div></a>{% endif %}{% endfor %}
    {% if rendered == 0 %}<p class="empty-state">{{ 'collection.updating' | t }} <a href="{{ routes.all_products_collection_url }}">{{ 'cart.shop_all' | t }}</a></p>{% endif %}
  </div>
</section>
{% schema %}{"name":"Collection list","settings":[]}{% endschema %}
