<section class="password-page">
  <div class="password-page__inner">
    {% render 'brand-logo', variant: 'dark', class: 'password-page__logo' %}
    <h1>{{ section.settings.heading | escape }}</h1>
    {% if shop.password_message != blank %}<p>{{ shop.password_message }}</p>{% endif %}
    {% form 'customer', class: 'newsletter-form' %}
      <input type="hidden" name="contact[tags]" value="newsletter,prospect">
      {% if form.posted_successfully? %}
        <p class="form-success" role="status">Thanks — we'll let you know when we open.</p>
      {% else %}
        {{ form.errors | default_errors }}
        <label class="visually-hidden" for="PasswordNewsletterEmail">Email</label>
        <input id="PasswordNewsletterEmail" type="email" name="contact[email]" autocomplete="email" placeholder="Your email" required>
        <button class="button button--dark" type="submit">Notify me</button>
      {% endif %}
    {% endform %}
    <div class="password-page__login">
      <p>Enter store using password</p>
      {% form 'storefront_password' %}
        {{ form.errors | default_errors }}
        <label class="visually-hidden" for="StorefrontPassword">Password</label>
        <input id="StorefrontPassword" type="password" name="password" autocomplete="current-password" placeholder="Password" required>
        <button class="button button--dark" type="submit">Enter</button>
      {% endform %}
      <p><small>Are you the store owner? <a href="/admin">Log in here</a></small></p>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }
  ]
}
{% endschema %}
