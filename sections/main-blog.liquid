<section class="page-width editorial-page">
  <header class="editorial-page__head"><p class="eyebrow">The Journal</p><h1>Editorial</h1><p>Dispatches on comfort, design, and living well.</p></header>
  {% paginate blog.articles by 12 %}
    <div class="blog-grid">
      {% for article in blog.articles %}{% assign article_image = article.image %}{% assign article_excerpt = article.excerpt_or_content | strip_html | truncate: 150 %}{% assign word_count = article.content | strip_html | split: ' ' | size %}{% assign reading_minutes = word_count | divided_by: 200 %}{% if reading_minutes < 1 %}{% assign reading_minutes = 1 %}{% endif %}<article class="blog-card"><a href="{{ article.url }}">{% if article_image %}<img src="{{ article_image | image_url: width: 900 }}" width="900" height="675" alt="{{ article_image.alt | default: article.title | escape }}" loading="lazy">{% else %}<span class="blog-card__placeholder" aria-hidden="true"></span>{% endif %}</a><div class="blog-card__meta">{% if article.tags.first != blank %}{{ article.tags.first }}{% else %}Nuage Journal{% endif %} · {{ reading_minutes }} min read</div><h2><a href="{{ article.url }}">{{ article.title }}</a></h2><p>{{ article_excerpt }}</p><a class="text-link" href="{{ article.url }}">Read article <span>→</span></a></article>{% else %}<p class="empty-state">No articles are published yet. Check back soon.</p>{% endfor %}
    </div>
    {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Blog pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Previous</a>{% endif %}<span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Next →</a>{% endif %}</nav>{% endif %}
  {% endpaginate %}
</section>
{% schema %}{"name":"Blog list","settings":[]}{% endschema %}
