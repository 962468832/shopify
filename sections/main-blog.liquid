<section class="page-width editorial-page">
  <header class="editorial-page__head"><p class="eyebrow">{{ 'article.journal' | t }}</p><h1>{{ 'journal.editorial' | t }}</h1><p>{{ 'journal.subtitle' | t }}</p></header>
  {% paginate blog.articles by 12 %}
    <div class="blog-grid">
      {% for article in blog.articles %}{% assign article_image = article.image %}{% assign raw_excerpt = article.excerpt_or_content | strip_html | strip %}{% capture t_excerpt %}{% render 'i18n', text: raw_excerpt %}{% endcapture %}{% assign article_excerpt = t_excerpt | strip | truncate: 150 %}{% assign word_count = article.content | strip_html | split: ' ' | size %}{% assign reading_minutes = word_count | divided_by: 200 %}{% if reading_minutes < 1 %}{% assign reading_minutes = 1 %}{% endif %}<article class="blog-card"><a href="{{ article.url }}">{% if article_image %}<img src="{{ article_image | image_url: width: 900 }}" width="900" height="675" alt="{{ article_image.alt | default: article.title | escape }}" loading="lazy">{% else %}<span class="blog-card__placeholder" aria-hidden="true"></span>{% endif %}</a><div class="blog-card__meta">{% if article.tags.first != blank %}{% render 'i18n', text: article.tags.first %}{% else %}{{ 'journal.brand_journal' | t }}{% endif %} · {{ reading_minutes }} {{ 'article.min_read' | t }}</div><h2><a href="{{ article.url }}">{% render 'i18n', text: article.title %}</a></h2><p>{{ article_excerpt }}</p><a class="text-link" href="{{ article.url }}">{{ 'journal.read_more' | t }} <span>→</span></a></article>{% else %}<p class="empty-state">{{ 'journal.no_articles' | t }}</p>{% endfor %}
    </div>
    {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Blog pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">{{ 'collection.prev' | t }}</a>{% endif %}<span>{{ 'collection.page' | t }} {{ paginate.current_page }} {{ 'collection.of' | t }} {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">{{ 'collection.next' | t }}</a>{% endif %}</nav>{% endif %}
  {% endpaginate %}
</section>
{% schema %}{"name":"Blog list","settings":[]}{% endschema %}
