<section class="page-width auth-page">
  <div class="auth-card">
    <p class="eyebrow">My account</p><h1>Reset password</h1>
    <p class="auth-card__intro">Choose a new password for your account.</p>
    {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <label for="ResetPassword">Password<input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required></label>
      <label for="ResetPasswordConfirm">Confirm password<input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required></label>
      <button class="button button--dark button--full" type="submit">Reset password</button>
    {% endform %}
  </div>
</section>
{% schema %}{"name":"Reset password","settings":[]}{% endschema %}
