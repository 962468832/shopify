<section class="page-width cart-page">
  <header class="cart-page__header">
    <div><p class="eyebrow">{{ 'cart.title' | t }}</p><h1>{{ 'cart.title' | t }} <span>({{ cart.item_count }})</span></h1></div>
    <a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }} <span aria-hidden="true">→</span></a>
  </header>
  {% if cart.item_count == 0 %}
    <div class="cart-page__empty"><h2>{{ 'cart.empty' | t }}</h2><p>{{ 'cart.empty_hint' | t }}</p><a class="button button--dark" href="{{ routes.all_products_collection_url }}">{{ 'cart.shop_all' | t }}</a></div>
  {% else %}
    {% assign cart_merchandise_discount = 0 %}
    {% for item in cart.items %}
      {% assign item_compare_line_price = item.variant.compare_at_price | times: item.quantity %}
      {% if item_compare_line_price > item.original_line_price %}
        {% assign cart_merchandise_discount = cart_merchandise_discount | plus: item_compare_line_price | minus: item.original_line_price %}
      {% endif %}
    {% endfor %}
    {%- assign ship_thresh_num = settings.cart_progress_threshold | default: 60 -%}
    {%- if ship_thresh_num > 0 -%}
      {%- assign ship_thresh_cents = ship_thresh_num | times: 100 -%}
      {%- assign ship_thresh_str = ship_thresh_cents | money_without_trailing_zeros -%}
      {%- assign ship_unlocked = false -%}
      {%- assign ship_pct = cart.total_price | times: 100 | divided_by: ship_thresh_cents -%}
      {%- if ship_pct > 100 -%}{%- assign ship_pct = 100 -%}{%- endif -%}
      {%- if cart.total_price >= ship_thresh_cents -%}
        {%- assign ship_unlocked = true -%}
      {%- else -%}
        {%- assign ship_remaining = ship_thresh_cents | minus: cart.total_price | money -%}
      {%- endif -%}
      <div class="cart-progress cart-progress--page{% if ship_unlocked %} is-unlocked{% endif %}" data-cart-progress>
        <p class="cart-progress__headline" data-cart-progress-headline>
          {%- if ship_unlocked -%}
            {%- if request.locale.iso_code contains 'zh' -%}已满 {{ ship_thresh_str }}，恭喜解锁<strong>全场包邮！</strong>{%- else -%}You've unlocked <strong>Free Shipping!</strong>{%- endif -%}
          {%- else -%}
            {%- if request.locale.iso_code contains 'zh' -%}再差 <strong>{{ ship_remaining }}</strong> 即可享满 {{ ship_thresh_str }} 全场包邮！{%- else -%}You're <strong>{{ ship_remaining }}</strong> away from Free Shipping!{%- endif -%}
          {%- endif -%}
        </p>
        <div class="cart-progress__bar-wrap">
          <div class="cart-progress__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ ship_pct }}">
            <span class="cart-progress__fill" data-cart-progress-bar style="width: {{ ship_pct }}%;"></span>
          </div>
          <span class="cart-progress__node" data-cart-progress-node aria-hidden="true">
            <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5 6.5 11.5 12.5 4.5"/></svg>
          </span>
        </div>
        <div class="cart-progress__scale">
          <span data-cart-progress-current>{{ cart.total_price | money }}</span>
          <span class="cart-progress__milestone" data-cart-progress-milestone>
            <strong>{{ ship_thresh_str }}</strong>
            <span>{% if request.locale.iso_code contains 'zh' %}全场包邮{% else %}FREE SHIPPING{% endif %}</span>
          </span>
        </div>
      </div>
    {%- endif -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart-page__form">
      <div class="cart-page__items">
        <div class="cart-page__column-labels" aria-hidden="true"><span>{{ 'cart.product' | t }}</span><span>{{ 'cart.total' | t }}</span></div>
        {% for item in cart.items %}
          <article class="cart-page__line">
            <a class="cart-page__line-image" href="{{ item.url }}">{% if item.image %}<img src="{{ item.image | image_url: width: 360 }}" width="180" height="240" alt="{{ item.image.alt | default: item.product.title | escape }}" loading="lazy">{% endif %}</a>
            <div class="cart-page__line-info">
              {% assign item_vendor = item.vendor | strip %}{% if item_vendor contains 'http' or item_vendor contains 'www.' or item_vendor == '我的商店' %}{% assign item_vendor = shop.name %}{% endif %}<p class="cart-page__vendor">{{ item_vendor }}</p>
              <h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2>
              {% unless item.product.has_only_default_variant %}<p class="cart-page__variant">{{ item.variant.title }}</p>{% endunless %}
              {% assign item_compare_line_price = item.variant.compare_at_price | times: item.quantity %}
              {% assign item_reference_line_price = item.original_line_price %}
              {% if item_compare_line_price > item_reference_line_price %}{% assign item_reference_line_price = item_compare_line_price %}{% endif %}
              {% assign item_reference_unit_price = item.original_price %}
              {% if item.variant.compare_at_price > item_reference_unit_price %}{% assign item_reference_unit_price = item.variant.compare_at_price %}{% endif %}
              {% assign item_save_percent = 0 %}
              {% if item_compare_line_price > item.original_line_price %}{% assign item_save_percent = item_compare_line_price | minus: item.original_line_price | times: 100.0 | divided_by: item_compare_line_price | round %}{% endif %}
              <p class="cart-page__unit-price">{{ item.final_price | money }}{% if item_reference_unit_price > item.final_price %} <s>{{ item_reference_unit_price | money }}</s>{% endif %}{% if item_save_percent > 0 %} <span class="cart-price__save">{{ 'products.product.save' | t }} {{ item_save_percent }}%</span>{% endif %}</p>
              {% for discount_allocation in item.line_level_discount_allocations %}<p class="cart-page__line-discount">{{ discount_allocation.discount_application.title | escape }} (−{{ discount_allocation.amount | money }})</p>{% endfor %}
              <div class="cart-page__line-actions">
                <div class="cart-page__quantity" role="group" aria-label="Quantity for {{ item.product.title | escape }}"><button type="button" data-cart-page-quantity="-1" aria-label="Decrease quantity for {{ item.product.title | escape }}">−</button><input type="number" min="0" name="updates[]" value="{{ item.quantity }}" aria-label="Quantity for {{ item.product.title | escape }}"><button type="button" data-cart-page-quantity="1" aria-label="Increase quantity for {{ item.product.title | escape }}">+</button></div>
                <a class="cart-page__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
              </div>
            </div>
            <div class="cart-page__line-total"><strong>{{ item.final_line_price | money }}</strong>{% if item_reference_line_price > item.final_line_price %}<s>{{ item_reference_line_price | money }}</s>{% endif %}</div>
          </article>
        {% endfor %}
        <button class="text-link cart-page__update" name="update" type="submit">{{ 'cart.update' | t }}</button>
      </div>
      <aside class="cart-page__summary">
        <h2>{{ 'cart.order_summary' | t }}</h2>
        <div class="cart-page__summary-row"><span>{{ 'cart.subtotal' | t }} ({{ cart.item_count }} {{ 'cart.items' | t }})</span><strong>{{ cart.items_subtotal_price | money }}</strong></div>
        {% for discount_application in cart.cart_level_discount_applications %}<div class="cart-page__summary-row cart-page__discount"><span>{{ discount_application.title | escape }}</span><strong>−{{ discount_application.total_allocated_amount | money }}</strong></div>{% endfor %}
        <div class="cart-page__summary-row cart-page__shipping"><span>{{ 'cart.shipping' | t }}</span><span>{% if ship_unlocked %}<strong class="cart-shipping-free">{% if request.locale.iso_code contains 'zh' %}免运费（满 {{ ship_thresh_str }} 包邮）{% else %}FREE{% endif %}</strong>{% else %}{{ 'cart.shipping_note' | t }}{% endif %}</span></div>
        <div class="cart-page__summary-row cart-page__total"><span>{{ 'cart.total' | t }}</span><strong>{{ cart.total_price | money }}</strong></div>
        {% if cart_merchandise_discount > 0 %}<p class="cart-page__savings">{{ 'cart.you_save_sale' | t }} {{ cart_merchandise_discount | money }} {{ 'cart.on_sale_items' | t }}</p>{% endif %}
        <p class="cart-page__tax-note">{{ 'cart.taxes_note' | t }}</p>
        <button class="button button--dark button--full" name="checkout" type="submit">{{ 'cart.checkout' | t }}</button>
        {% if additional_checkout_buttons %}<div class="additional-checkout-buttons">{{ content_for_additional_checkout_buttons }}</div>{% endif %}
        <p class="cart-page__secure"><span aria-hidden="true">✓</span> {{ 'cart.secure_checkout' | t }}</p>
        <a class="cart-page__continue" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      </aside>
    </form>
  {% endif %}
</section>
