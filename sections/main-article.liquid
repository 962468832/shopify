{% assign word_count = article.content | strip_html | split: ' ' | size %}{% assign reading_minutes = word_count | divided_by: 200 %}{% if reading_minutes < 1 %}{% assign reading_minutes = 1 %}{% endif %}
<article class="page-width article-page">
  <header class="article-page__head"><p class="eyebrow">{% if article.tags.first != blank %}{% render 'i18n', text: article.tags.first %}{% else %}{{ 'article.journal' | t }}{% endif %}</p><h1>{% render 'i18n', text: article.title %}</h1><div class="article-meta">{{ article.published_at | date: '%Y-%m-%d' }} · {{ reading_minutes }} {{ 'article.min_read' | t }}</div></header>
  {% if article.image %}<img class="article-page__image" src="{{ article.image | image_url: width: 1800 }}" width="1800" height="1100" alt="{{ article.image.alt | default: article.title | escape }}">{% endif %}
  <div class="article-page__body rte">{{ article.content }}</div>
  <nav class="article-page__footer" aria-label="Article navigation"><a href="{{ blog.url }}">{{ 'article.back' | t }}</a><span>{% if blog.previous_article %}<a href="{{ blog.previous_article.url }}">{{ 'article.previous' | t }}</a>{% endif %}</span><span>{% if blog.next_article %}<a href="{{ blog.next_article.url }}">{{ 'article.next' | t }}</a>{% endif %}</span></nav>
  {% if blog.comments_enabled? %}
    <section class="article-comments" aria-labelledby="ArticleCommentsTitle">
      <h2 id="ArticleCommentsTitle">{{ article.comments_count }} {{ 'article.comments' | t }}</h2>
      {% paginate article.comments by 20 %}
        {% for comment in article.comments %}
          <article class="article-comment" id="{{ comment.id }}">
            <div class="rte">{{ comment.content }}</div>
            <p class="article-meta">{{ comment.author }} · {{ comment.created_at | date: '%B %d, %Y' }}</p>
          </article>
        {% endfor %}
        {% if paginate.pages > 1 %}<nav class="pagination" aria-label="Comments pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">{{ 'article.page_prev' | t }}</a>{% endif %}<span>{{ 'article.page_of' | t }} {{ paginate.current_page }} / {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">{{ 'article.page_next' | t }}</a>{% endif %}</nav>{% endif %}
      {% endpaginate %}
      <div class="contact-page__form">
        {% form 'new_comment', article %}
          <h3>{{ 'article.leave_comment' | t }}</h3>
          {% if form.posted_successfully? %}
            <p class="form-success" role="status">{% if blog.moderated? %}{{ 'article.posted_moderated' | t }}{% else %}{{ 'article.posted' | t }}{% endif %}</p>
          {% elsif form.errors %}
            <div class="errors" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}
          <div class="form-grid form-grid--two">
            <label for="CommentAuthor">{{ 'article.name' | t }}<input id="CommentAuthor" type="text" name="comment[author]" value="{{ form.author }}" autocomplete="name" required></label>
            <label for="CommentEmail">{{ 'article.email' | t }}<input id="CommentEmail" type="email" name="comment[email]" value="{{ form.email }}" autocomplete="email" required></label>
          </div>
          <label for="CommentBody">{{ 'article.message' | t }}<textarea id="CommentBody" name="comment[body]" rows="5" required>{{ form.body }}</textarea></label>
          {% if blog.moderated? %}<p><small>{{ 'article.moderated_note' | t }}</small></p>{% endif %}
          <button class="button button--dark" type="submit">{{ 'article.post_comment' | t }}</button>
        {% endform %}
      </div>
    </section>
  {% endif %}
  {% assign recommended_collection = section.settings.collection | default: collections['softveil-collection'] %}{% if recommended_collection != blank %}<section class="article-page__recommendations"><h2>{{ 'article.shop_story' | t }}</h2><div class="product-grid">{% for product in recommended_collection.products limit: 4 %}{% render 'product-card', product: product, show_color_options: true %}{% endfor %}</div></section>{% endif %}
</article>
{% schema %}{"name":"Article","settings":[{"type":"collection","id":"collection","label":"Recommended collection"}]}{% endschema %}
