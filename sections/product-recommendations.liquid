<section class="product-recommendations page-width" data-product-recommendations data-product-id="{{ product.id }}" aria-labelledby="product-recommendations-title" hidden>
  <header class="product-recommendations__header">
    <div>
      <p class="eyebrow">{{ 'collection.keep_exploring' | t }}</p>
      <h2 id="product-recommendations-title">{% render 'i18n', text: section.settings.heading %}</h2>
    </div>
    <a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'collection.shop_all' | t }} <span>↗</span></a>
  </header>
  <div class="product-recommendations__grid" data-product-recommendation-items></div>
</section>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
