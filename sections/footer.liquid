{% assign news_blog = blogs.news %}
<footer class="site-footer">
  <div class="page-width footer-grid">
    <div class="footer-intro"><a class="footer-brand" href="{{ routes.root_url }}">{% render 'brand-logo', variant: 'dark', loading: 'lazy' %}</a><p>We solve real problems - invisible seams, no wedgies, no digging, breathable. Intimate confidence you can trust.</p></div>
    {% assign shop_links = section.settings.shop_menu.links %}{% assign discover_links = section.settings.discover_menu.links %}{% assign support_links = section.settings.support_menu.links %}
    <div><h3>{{ section.settings.shop_heading | default: 'Shop' | escape }}</h3>{% if shop_links != blank %}{% for link in shop_links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}{% assign footer_handles = 'best-sellers-2026,new-arrivals-2026,undies-2026,bras-2026,sculpt-lift,sale-2026' | split: ',' %}{% assign footer_labels = 'nav.best_sellers,nav.new_arrivals,nav.underwear,nav.bras,nav.shapewear,nav.last_chance' | split: ',' %}{% for h in footer_handles %}{% assign c = collections[h] %}{% if c.products_count > 0 %}<a href="{{ c.url }}">{{ footer_labels[forloop.index0] | t }}</a>{% endif %}{% endfor %}<a href="{{ routes.all_products_collection_url }}">{{ 'nav.shop_all' | t }}</a>{% endif %}</div>
    <div><h3>{{ section.settings.discover_heading | default: 'Discover' | escape }}</h3>{% if discover_links != blank %}{% for link in discover_links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}<a href="/pages/engineering-lab">{{ 'footer.engineering_lab' | t }}</a><a href="/pages/about-us">{{ 'footer.about_us' | t }}</a>{% if news_blog != blank %}<a href="{{ news_blog.url }}">{{ 'footer.blogs' | t }}</a>{% endif %}{% assign gift_card_product = all_products['summer-gift-card'] %}{% if gift_card_product != blank %}<a href="{{ gift_card_product.url }}">{{ 'footer.gift_card' | t }}</a>{% endif %}{% endif %}</div>
    <div><h3>{{ section.settings.support_heading | default: 'Support' | escape }}</h3>{% if support_links != blank %}{% for link in support_links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}<a href="/pages/faq">{{ 'footer.faq' | t }}</a><a href="/pages/the-best-pair-guarantee">{{ 'footer.guarantee' | t }}</a><a href="/policies/shipping-policy">{{ 'footer.shipping' | t }}</a><a href="/policies/refund-policy">{{ 'footer.returns' | t }}</a>{% if pages['policies'] != blank %}<a href="{{ pages['policies'].url }}">{{ 'footer.all_policies' | t }}</a>{% endif %}<a href="/pages/contact">{{ 'footer.contact' | t }}</a>{% endif %}</div>
    <div class="footer-signup"><h3>{{ 'footer.newsletter_heading' | t }}</h3><p>{{ 'footer.newsletter_text' | t }}</p>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="NewsletterEmail">{{ 'footer.email' | t }}</label><input id="NewsletterEmail" type="email" name="contact[email]" placeholder="{{ 'footer.email_placeholder' | t }}" required><button class="button button--light" type="submit">{{ 'footer.subscribe' | t }} <span aria-hidden="true">→</span></button>{% endform %}</div>
  </div>
  {%- if localization.available_languages.size > 1 -%}
  <div class="page-width footer-locale">
    {%- form 'localization', id: 'FooterLanguageForm', class: 'footer-locale__form' -%}
      <label class="footer-locale__label" for="FooterLanguage">{{ 'general.language' | t | default: 'Language' }}</label>
      <span class="footer-locale__select">
        <select id="FooterLanguage" name="language_code" aria-label="Language" onchange="this.form.submit()">
          {%- for language in localization.available_languages -%}
            <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
          {%- endfor -%}
        </select>
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </span>
      <noscript><button type="submit" class="footer-locale__submit">Update</button></noscript>
    {%- endform -%}
  </div>
  {%- endif -%}
  <div class="page-width footer-bottom"><span>copyright: {{ 'now' | date: '%Y' }} © {{ shop.name | capitalize }}</span><span><a href="/policies/terms-of-service">{{ 'footer.terms' | t }}</a><a href="/policies/privacy-policy">{{ 'footer.privacy' | t }}</a><button type="button" data-cookie-preferences data-fallback-url="{{ settings.cookie_preferences_url | default: '/policies/privacy-policy' }}">{{ 'footer.cookie_preferences' | t }}</button></span></div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {"type": "link_list", "id": "shop_menu", "label": "Shop menu"},
    {"type": "link_list", "id": "discover_menu", "label": "Discover menu"},
    {"type": "link_list", "id": "support_menu", "label": "Support menu"},
    {"type": "text", "id": "shop_heading", "label": "Shop heading", "default": "Shop"},
    {"type": "text", "id": "discover_heading", "label": "Discover heading", "default": "Discover"},
    {"type": "text", "id": "support_heading", "label": "Support heading", "default": "Support"}
  ]
}
{% endschema %}
