{% assign news_blog = blogs.news %}
<footer class="site-footer">
  <div class="page-width footer-grid">
    <div class="footer-intro"><a class="footer-brand" href="{{ routes.root_url }}">{% render 'brand-logo', variant: 'dark', loading: 'lazy' %}</a><p>We solve real problems - invisible seams, no wedgies, no digging, breathable. Intimate confidence you can trust.</p></div>
    {% assign shop_links = section.settings.shop_menu.links %}{% assign discover_links = section.settings.discover_menu.links %}{% assign support_links = section.settings.support_menu.links %}
    <div><h3>{{ section.settings.shop_heading | default: 'Shop' | escape }}</h3>{% if shop_links != blank %}{% for link in shop_links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}{% assign footer_handles = 'best-sellers-2026,new-arrivals-2026,undies-2026,bras-2026,sculpt-lift,sale-2026' | split: ',' %}{% assign footer_labels = 'Best Sellers,New Arrivals,Underwear,Bras,Shapewear,Last Chance' | split: ',' %}{% for h in footer_handles %}{% assign c = collections[h] %}{% if c.products_count > 0 %}<a href="{{ c.url }}">{{ footer_labels[forloop.index0] }}</a>{% endif %}{% endfor %}<a href="{{ routes.all_products_collection_url }}">Shop All</a>{% endif %}</div>
    <div><h3>{{ section.settings.discover_heading | default: 'Discover' | escape }}</h3>{% if discover_links != blank %}{% for link in discover_links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}<a href="/pages/engineering-lab">Engineering Lab</a><a href="/pages/about-us">About Us</a>{% if news_blog != blank %}<a href="{{ news_blog.url }}">Blogs</a>{% endif %}{% assign gift_card_product = all_products['summer-gift-card'] %}{% if gift_card_product != blank %}<a href="{{ gift_card_product.url }}">Gift Card</a>{% endif %}{% endif %}</div>
    <div><h3>{{ section.settings.support_heading | default: 'Support' | escape }}</h3>{% if support_links != blank %}{% for link in support_links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}{% else %}<a href="/pages/faq">FAQ</a><a href="/pages/the-best-pair-guarantee">Best Pair Guarantee</a><a href="/policies/shipping-policy">Shipping</a><a href="/policies/refund-policy">Returns &amp; Exchanges</a>{% if pages['policies'] != blank %}<a href="{{ pages['policies'].url }}">All Policies</a>{% endif %}<a href="/pages/contact">Contact Us</a>{% endif %}</div>
    <div class="footer-signup"><h3>Stay in the loop</h3><p>Early access to new colors and collections.</p>{% form 'customer', class: 'newsletter-form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="NewsletterEmail">Email</label><input id="NewsletterEmail" type="email" name="contact[email]" placeholder="Your email" required><button class="button button--light" type="submit">Subscribe <span aria-hidden="true">→</span></button>{% endform %}</div>
  </div>
  <div class="page-width footer-bottom"><span>copyright: {{ 'now' | date: '%Y' }} © {{ shop.name | capitalize }}</span><span><a href="/policies/terms-of-service">Terms of Service</a><a href="/policies/privacy-policy">Privacy Policy</a><button type="button" data-cookie-preferences data-fallback-url="{{ settings.cookie_preferences_url | default: '/policies/privacy-policy' }}">Cookie Preferences</button></span></div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {"type": "link_list", "id": "shop_menu", "label": "Shop menu"},
    {"type": "link_list", "id": "discover_menu", "label": "Discover menu"},
    {"type": "link_list", "id": "support_menu", "label": "Support menu"},
    {"type": "text", "id": "shop_heading", "label": "Shop heading", "default": "Shop"},
    {"type": "text", "id": "discover_heading", "label": "Discover heading", "default": "Discover"},
    {"type": "text", "id": "support_heading", "label": "Support heading", "default": "Support"}
  ]
}
{% endschema %}
