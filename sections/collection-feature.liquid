{% assign collection = collections[section.settings.collection] %}{% assign feature_image = section.settings.image | image_url: width: 1200 %}{% if feature_image == blank %}{% assign feature_image = collection.image | image_url: width: 1200 %}{% endif %}<section class="feature-band {% if section.settings.image_position == 'right' %}feature-band--reverse{% endif %}"><div class="feature-band__media" style="--feature-image:url('{{ feature_image }}')"></div><div class="feature-band__copy"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p class="feature-band__sub">{{ section.settings.subheading }}</p><p>{{ section.settings.description }}</p><a class="button button--dark" href="{{ collection.url | default: routes.all_products_collection_url }}">{{ section.settings.button_label | default: 'Shop collection' }}</a></div></section><div class="page-width feature-products">{% if collection != blank %}{% assign shown_products = 0 %}{% for product in collection.products %}{% assign product_title = product.title | downcase %}{% assign product_handle = product.handle | downcase %}{% unless product_title contains 'gift card' or product_handle contains 'gift-card' %}{% render 'product-card', product: product %}{% assign shown_products = shown_products | plus: 1 %}{% if shown_products >= 4 %}{% break %}{% endif %}{% endunless %}{% endfor %}{% endif %}</div>
{% schema %}{"name":"Collection feature","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Featured collection"},{"type":"text","id":"heading","label":"Heading","default":"The Featherlight Collection"},{"type":"text","id":"subheading","label":"Subheading","default":"Our softest fabric, reimagined"},{"type":"textarea","id":"description","label":"Description","default":"Cloud-soft essentials that feel like nothing at all."},{"type":"image_picker","id":"image","label":"Image"},{"type":"collection","id":"collection","label":"Collection"},{"type":"select","id":"image_position","label":"Image position","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}],"default":"left"},{"type":"text","id":"button_label","label":"Button label","default":"Shop collection"}],"presets":[{"name":"Collection feature"}]}{% endschema %}
