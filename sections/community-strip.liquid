<section class="home-section home-community" data-home-carousel><div class="home-container"><div class="home-heading"><div><p class="home-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><span class="home-hint">{{ section.settings.hint | escape }}</span></div>
<div class="home-rail home-community-rail" data-home-rail tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}">
{% for block in section.blocks %}<article class="home-story" {{ block.shopify_attributes }}>{% render 'home-video', video:block.settings.video, video_url:block.settings.video_url, poster:block.settings.poster, poster_url:block.settings.poster_url, title:block.settings.title, mode:'hover' %}<a href="{{ block.settings.link | default: routes.all_products_collection_url }}"><h3>{{ block.settings.title | escape }}</h3>{% if block.settings.button_label != blank %}<span class="home-text-link">{{ block.settings.button_label | escape }} →</span>{% endif %}</a></article>{% endfor %}
</div>{% render 'home-rail-controls', label:section.settings.heading %}</div></section>
{% schema %}
{
  "name": "社区视频故事",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "上方小标题",
      "default": "Real People, Real Comfort"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "From the Community"
    },
    {
      "type": "text",
      "id": "hint",
      "label": "浏览提示",
      "default": "Scroll or drag to browse · hover to play"
    }
  ],
  "presets": [
    {
      "name": "社区视频故事",
      "blocks": [
        {
          "type": "story"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "视频故事卡片",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "视频",
          "info": "从文件库选择或直接上传视频。未选择时沿用现有视频。"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "视频封面",
          "info": "不选封面时，使用所选视频的默认封面。"
        },
        {
          "type": "checkbox",
          "id": "show_legacy_media",
          "label": "显示旧版素材地址",
          "info": "仅兼容原有内容，日常更换素材请使用上方选择器。",
          "default": false
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "旧版视频地址",
          "visible_if": "{{ block.settings.show_legacy_media }}"
        },
        {
          "type": "url",
          "id": "poster_url",
          "label": "旧版封面地址",
          "visible_if": "{{ block.settings.show_legacy_media }}"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Community story"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "按钮文字",
          "default": "Shop the look"
        },
        {
          "type": "url",
          "id": "link",
          "label": "商品或集合链接"
        }
      ]
    }
  ],
  "max_blocks": 10
}
{% endschema %}
