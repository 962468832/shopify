{% assign category_collection_handles = 'mid-rise-brief,thongs,hipster,high-rise,cheeky' | split: ',' %}
{% assign category_collection_titles = 'Mid-Rise Brief,Thongs,Hipster,High-Rise,Cheeky' | split: ',' %}
{% assign has_active_filter = false %}
{% for filter in collection.filters %}{% if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank %}{% assign has_active_filter = true %}{% endif %}{% endfor %}
{% assign has_non_default_sort = false %}{% if collection.sort_by != blank and collection.sort_by != collection.default_sort_by %}{% assign has_non_default_sort = true %}{% endif %}
{% assign show_grouped = false %}{% if collection.handle == 'all' and has_active_filter == false and has_non_default_sort == false %}{% assign show_grouped = true %}{% endif %}

<section class="page-width collection-page">
  {% if collection.handle == 'all' %}
    <div class="collection-categories" aria-labelledby="shop-by-collection">
      <div class="section-heading"><div><p class="eyebrow">Find your fit</p><h2 id="shop-by-collection">Shop by collection</h2><p>Find the collection made for the way you want to feel, fit, and move every day.</p></div></div>
      <div class="category-grid">
        {% for handle in category_collection_handles %}{% assign category = collections[handle] %}{% if category != blank %}{% assign category_image = category.image | default: category.products.first.featured_image %}<a class="category-card" href="{{ category.url }}">{% if category_image %}<img src="{{ category_image | image_url: width: 640 }}" width="640" height="800" alt="{{ category_collection_titles[forloop.index0] | escape }}" loading="lazy">{% else %}<span class="category-card__placeholder" aria-hidden="true"></span>{% endif %}<span>{{ category_collection_titles[forloop.index0] }}</span></a>{% endif %}{% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="collection-head"><p class="eyebrow">{% if collection.handle == 'sale-2026' %}Limited time{% else %}Collection{% endif %}</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</div>
  <div class="collection-toolbar"><span>{{ collection.products_count }} products</span><button class="text-link" data-filter-toggle aria-expanded="false" aria-controls="collection-filters">All filters <span aria-hidden="true">↘</span></button></div>
  <div class="collection-layout">
    <aside class="filters" id="collection-filters" data-filters><form method="get" action="{{ collection.url }}" class="collection-filter-form">
      <div class="filter-form__heading"><strong>All filters</strong><button class="filter-close" type="button" data-filter-close aria-label="Close filters">×</button>{% if has_active_filter %}<a class="clear-filters" href="{{ collection.url }}">Clear all</a>{% endif %}</div>
      {% for filter in collection.filters %}<details class="filter-group"{% if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank %} open{% endif %}><summary>{{ filter.label }}{% if filter.active_values.size > 0 %}<span> ({{ filter.active_values.size }})</span>{% endif %}</summary><div class="filter-group__values">
        {% case filter.type %}{% when 'list' %}{% for filter_value in filter.values %}<label class="filter-value"><input type="checkbox" name="{{ filter_value.param_name }}" value="{{ filter_value.value | escape }}"{% if filter_value.active %} checked{% endif %}{% if filter_value.count == 0 and filter_value.active == false %} disabled{% endif %}><span>{{ filter_value.label }}</span><small>{{ filter_value.count }}</small></label>{% endfor %}{% when 'price_range' %}<div class="price-range"><label>From <input name="{{ filter.min_value.param_name }}" type="number" min="0" step="0.01" placeholder="0" value="{% if filter.min_value.value %}{{ filter.min_value.value | divided_by: 100.0 }}{% endif %}"></label><label>To <input name="{{ filter.max_value.param_name }}" type="number" min="0" step="0.01" placeholder="{{ filter.range_max | divided_by: 100.0 | ceil }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | divided_by: 100.0 }}{% endif %}"></label></div>{% endcase %}</div></details>{% endfor %}
      <label class="sort-label">Sort by<select name="sort_by">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>{% endfor %}</select></label>
      <button class="button button--dark button--full" type="submit">Apply filters</button>
    </form></aside>

    {% if show_grouped %}
      <div class="underwear-groups">
        {% assign group_labels = 'NuCloud,NuAir,NuFit,NuForme,NuBloom' | split: ',' %}
        {% assign group_eyebrows = 'Signature seamless comfort,Cooling performance mesh,Shape-specific fit,Gentle sculpting support,Seamless floral lace' | split: ',' %}
        {% assign group_headings = 'Feel Like You’re Wearing Nothing.,Stay Cool Through Every Move.,Made for Your Shape.,Smooth Your Shape. Keep Your Comfort.,Romance You Can Wear Every Day.' | split: ',' %}
        {% assign group_descriptions = 'Buttery-soft seamless fabric and raw-cut edges for all-day comfort that stays invisible under everything.,Breathable performance fabric releases heat and sweat to keep you cool and dry wherever the day takes you.,Thoughtfully designed fits deliver personalized stay-put comfort without shifting.,Gentle support smooths your silhouette while staying soft and flexible for everyday wear.,Delicate stretch lace and seamless construction feel effortlessly feminine and comfortable.' | split: ',' %}
        {% assign group_handles = '2026-nucloud,2026-nuair,nufit,2026-nuforme,nubloom' | split: ',' %}
        {% for group_handle in group_handles %}{% assign group_products = collections[group_handle] %}{% if group_products != blank and group_products.products_count > 0 %}<section class="underwear-group" aria-labelledby="group-{{ group_handle }}"><div class="underwear-group__head"><div><p class="eyebrow">{{ group_eyebrows[forloop.index0] }}</p><h2 id="group-{{ group_handle }}">{{ group_headings[forloop.index0] }}</h2><p>{{ group_descriptions[forloop.index0] }}</p></div><a class="text-link" href="{{ group_products.url }}">Shop {{ group_labels[forloop.index0] }} <span>↗</span></a></div><div class="product-grid underwear-group__grid">{% for product in group_products.products limit: 12 %}{% unless product.product_type == 'Gift Card' or product.handle contains 'gift-card' %}{% render 'product-card', product: product, show_color_options: true %}{% endunless %}{% endfor %}</div></section>{% endif %}{% endfor %}
        {% assign all_underwear = collections['undies-2026'] %}{% assign general_count = 0 %}{% if all_underwear != blank %}{% for product in all_underwear.products %}{% assign group_membership = false %}{% for group_handle in group_handles %}{% assign group_products = collections[group_handle] %}{% if group_products.products contains product %}{% assign group_membership = true %}{% endif %}{% endfor %}{% unless group_membership or product.product_type == 'Gift Card' or product.handle contains 'gift-card' %}{% assign general_count = general_count | plus: 1 %}{% endunless %}{% endfor %}{% endif %}
        {% assign general_rendered = 0 %}{% if general_count > 0 %}<section class="underwear-group underwear-group--general"><div class="underwear-group__head"><div><p class="eyebrow">All underwear</p><h2>More comfort, your way.</h2></div><a class="text-link" href="{{ all_underwear.url }}">Shop all underwear <span>↗</span></a></div><div class="product-grid underwear-group__grid">{% for product in all_underwear.products %}{% assign group_membership = false %}{% for group_handle in group_handles %}{% assign group_products = collections[group_handle] %}{% if group_products.products contains product %}{% assign group_membership = true %}{% endif %}{% endfor %}{% unless group_membership or product.product_type == 'Gift Card' or product.handle contains 'gift-card' %}{% assign general_rendered = general_rendered | plus: 1 %}{% render 'product-card', product: product, show_color_options: true %}{% if general_rendered >= 24 %}{% break %}{% endif %}{% endunless %}{% endfor %}</div></section>{% endif %}
      </div>
    {% else %}
      <div class="collection-results">{% paginate collection.products by 24 %}<div class="product-grid">{% for product in collection.products %}{% unless product.product_type == 'Gift Card' or product.handle contains 'gift-card' %}{% render 'product-card', product: product, show_color_options: true %}{% endunless %}{% else %}<p class="empty-state">No products found.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="Pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Previous</a>{% endif %}<span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Next →</a>{% endif %}</nav>{% endif %}{% endpaginate %}</div>
    {% endif %}
  </div>

  {% assign recommendation_handles = '2026-nucloud,2026-nuair,nufit' | split: ',' %}
  <section class="collection-recommendations" aria-labelledby="collection-recommendations-title">
    <div class="collection-recommendations__head"><div><p class="eyebrow">Keep exploring</p><h2 id="collection-recommendations-title">Find your next favorite</h2></div><a class="text-link" href="{{ routes.all_products_collection_url }}">Shop all <span>↗</span></a></div>
    <div class="collection-recommendations__grid">
      {% for recommendation_handle in recommendation_handles %}{% assign recommendation = collections[recommendation_handle] %}{% if recommendation != blank %}{% assign recommendation_image = recommendation.image | default: recommendation.products.first.featured_image %}<a class="collection-recommendation" href="{{ recommendation.url }}">{% if recommendation_image %}<img src="{{ recommendation_image | image_url: width: 720 }}" width="720" height="540" alt="{{ recommendation.title | escape }}" loading="lazy">{% else %}<span class="collection-recommendation__placeholder" aria-hidden="true"></span>{% endif %}<span>{{ recommendation.title }}</span></a>{% endif %}{% endfor %}
    </div>
  </section>
</section>
