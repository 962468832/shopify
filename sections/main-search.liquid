<section class="page-width search-page"><div class="collection-head"><p class="eyebrow">Search</p><h1>{% if search.performed %}Results for “{{ search.terms }}”{% else %}Find your comfort{% endif %}</h1><form class="search-form" action="{{ routes.search_url }}"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products..."><button class="button button--dark">Search</button></form></div>{% if search.performed %}<div class="product-grid">{% paginate search.results by 24 %}{% for item in search.results %}{% if item.object_type == 'product' %}{% assign product_title = item.title | downcase %}{% assign product_handle = item.handle | downcase %}{% unless product_title contains 'bra' or product_title contains 'bralette' or product_handle contains 'bra' or product_handle contains 'bralette' %}{% render 'product-card', product: item %}{% endunless %}{% endif %}{% else %}<p class="empty-state">No results found.</p>{% endfor %}{% endpaginate %}</div>{% endif %}</section>
